# CQ-TMF12: Which service quality reports show SLA non-compliance,
#           and what metrics breached their thresholds?
# TMF657 ServiceQualityReport — Phase 2B
PREFIX : <https://ontology.example.com/tmf/>

SELECT ?report ?reportType ?service ?qualityScore ?slaCompliant
WHERE {
  ?report a :ServiceQualityReport ;
          :slaCompliant ?slaCompliant .
  FILTER(?slaCompliant = false)
  OPTIONAL { ?report :reportType ?reportType }
  OPTIONAL { ?report :coversService ?service }
  OPTIONAL { ?report :overallQualityScore ?qualityScore }
}
ORDER BY ?qualityScore
