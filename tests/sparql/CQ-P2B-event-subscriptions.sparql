# CQ-P2B-02: Which event subscriptions are active, what event types
#            do they cover, and which parties are subscribed?
# Phase 2B TMF Event Hub — TMF630 §5
PREFIX : <https://ontology.example.com/tmf/>

SELECT ?subscription ?eventType ?eventDomain ?subscriber ?callbackUrl
WHERE {
  ?subscription a :EventSubscription ;
                :hasEventType ?eventType ;
                :hasCallbackUrl ?callbackUrl .
  FILTER NOT EXISTS { ?subscription :hasTicketStatus "Cancelled" }
  OPTIONAL { ?subscription :hasEventDomain ?eventDomain }
  OPTIONAL { ?subscription :subscriberParty ?subscriber }
}
ORDER BY ?eventType
