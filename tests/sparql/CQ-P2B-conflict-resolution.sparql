# CQ-P2B-01: Which conflict events are unresolved or escalated to humans,
#            what is the conflict type, and what is the resolution tier?
# Phase 2B Multi-Agent Conflict Resolution
PREFIX : <https://ontology.example.com/tmf/>

SELECT ?conflict ?conflictType ?tier ?assertionA ?assertionB ?status
WHERE {
  ?conflict a :ConflictEvent ;
            :hasConflictType ?conflictType ;
            :hasTicketStatus ?status .
  FILTER(?status IN ("Open","Escalated"))
  OPTIONAL { ?conflict :hasAssertionAIri ?assertionA }
  OPTIONAL { ?conflict :hasAssertionBIri ?assertionB }
  OPTIONAL { ?conflict :hasResolutionTier ?tier }
}
ORDER BY ?tier ?conflictType
