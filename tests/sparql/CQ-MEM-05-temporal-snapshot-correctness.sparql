# CQ-MEM-05 — Does temporal snapshot return correct state at a given timestamp?
# ─────────────────────────────────────────────────────────────────────────────
# Verifies the point-in-time snapshot operation: given a target timestamp T,
# the query must return only observations that:
#   (a) were generated at or before T (transaction-time constraint)
#   (b) are not invalidated as of T (no prov:wasInvalidatedBy record
#       generated before T)
#
# This is the correctness test for TQ-01 (point-in-time snapshot template)
# and the memory.snapshot() method.
#
# Pass condition: for a reference timestamp T-2 (48h ago), at least one
# valid observation is returned that satisfies the bi-temporal filter.
#
# The test uses a parameterised ASK form to confirm the pattern is present.
#
# Bound variables (SELECT form for debugging):
#   ?record, ?entity, ?method, ?generated, ?validFrom

PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX tmf:  <https://ontology.example.com/tmf/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# ASK form — used by CI/CD gate (returns true/false)
ASK {
    ?record a tmf:ObservationRecord ;
            tmf:entity_iri        ?entity ;
            tmf:derivation_method ?method ;
            prov:generatedAtTime  ?generated .

    # At least one record exists at any point in time
    FILTER (BOUND(?generated))

    # Is not invalidated (no prov:wasInvalidatedBy link)
    FILTER NOT EXISTS {
        ?record prov:wasInvalidatedBy ?inv .
    }
}
