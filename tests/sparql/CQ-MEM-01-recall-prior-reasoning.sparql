# CQ-MEM-01 — Can recall retrieve prior reasoning for a given subject?
# ─────────────────────────────────────────────────────────────────────
# Verifies that the memory.recall() operation can surface ObservationRecord
# entries that were previously generated by an agent for a given subject IRI.
# This is the primary competency question for the memory API core component.
#
# Pass condition: at least one ObservationRecord exists that:
#   (a) has a known entity_iri (not null/empty)
#   (b) has a derivation_method (SYNTHESIZED, MEASURED, or INFERRED)
#   (c) has a generation timestamp
#   (d) is not invalidated
#
# Bound variables:
#   ?record, ?entity, ?method, ?generated, ?valueText

PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX tmf:  <https://ontology.example.com/tmf/>

SELECT ?record ?entity ?method ?generated ?valueText
WHERE {
    ?record a tmf:ObservationRecord ;
            tmf:entity_iri        ?entity ;
            tmf:derivation_method ?method ;
            prov:generatedAtTime  ?generated .

    OPTIONAL { ?record tmf:value_text ?valueText }

    # Exclude invalidated records
    FILTER NOT EXISTS { ?record prov:wasInvalidatedBy ?inv }

    # Ensure entity is not blank
    FILTER (STRLEN(STR(?entity)) > 0)
}
ORDER BY DESC(?generated)
LIMIT 10
