# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
pip-wheel-metadata/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env
ENV/

# ── Generated database ────────────────────────────────────────────────────────
db/enterprise.db
db/demo.db
db/demo_5g.db
db/ontologies.db
db/*.db-shm
.wizard_session.json
.claude/launch.json
db/*.db-wal

# ── Generated output artefacts ────────────────────────────────────────────────
# Keep the JSON-LD / ontology source files that are committed intentionally,
# but exclude everything that is rebuilt on every pipeline run.
output/reports/
output/logs/
output/tmp/
# First-contact demo runtime directory (regenerated by ./demo.sh)
output/demo/
# 5G-NF first-contact demo runtime directory (regenerated by ./demo_5g.sh)
output/demo-5g/
# Specific generated files re-emitted every run:
output/jsonld/mcp-tools.json
output/jsonld/runtime-mcp-tools.json

# ── IDE / editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ── Secrets / credentials ─────────────────────────────────────────────────────
.env
.env.*
secrets.json
credentials.json
*.pem
*.key

# ── Test / coverage artefacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.log

# ── MyPy / type-checker caches ────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Workstream 3 (federation) local state ────────────────────────────────────
# Signing keys and the live runtime registry never enter source control.
# The committed partner_registry.json stays — it's the declarative seed.
federation/keys/*.sk
federation/keys/*.pub
federation/manifests/*.jsonld

# ── Workstream 4 (compliance) local state ────────────────────────────────────
# Signing keys and emitted evidence bundles are runtime state, not source.
# The committed compliance/regulations/*.json files stay — they are the
# declarative regulatory registry.
compliance/keys/*.sk
compliance/keys/*.pub
compliance/bundles/*.zip

# wizard demo output (regenerated by examples/wizard/demo_wizard.sh)
projects/
