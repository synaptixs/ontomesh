# ── ObservationRecord ──────────────────────────────────────────
shapes:ObservationRecordShape
  a sh:NodeShape ;
  sh:targetClass :ObservationRecord ;
  sh:property [
    sh:path :hasObservationIri ;
    sh:datatype xsd:anyURI ;
    sh:message "Observation Iri: type xsd:anyURI." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasObservationType ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "Observation Type: required, type xsd:string." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasNumericValue ;
    sh:datatype xsd:decimal ;
    sh:message "Numeric Value: type xsd:decimal." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasTextValue ;
    sh:datatype xsd:string ;
    sh:message "Text Value: type xsd:string." ;
    sh:severity sh:Warning
