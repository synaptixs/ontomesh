    sh:message "Ticket Iri: type xsd:anyURI." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasTicketType ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "Ticket Type: required, type xsd:string." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasDescription ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "Description: required, type xsd:string." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasSeverity ;
    sh:datatype xsd:string ;
    sh:message "Severity: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasPriority ;
    sh:datatype xsd:string ;
    sh:message "Priority: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasStatus ;
    sh:datatype xsd:string ;
    sh:message "Status: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasCategory ;
    sh:datatype xsd:string ;
    sh:message "Category: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasSubCategory ;
    sh:datatype xsd:string ;
    sh:message "Sub Category: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasResolutionNotes ;
    sh:datatype xsd:string ;
    sh:message "Resolution Notes: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasExpectedResolution ;
    sh:datatype xsd:string ;
    sh:message "Expected Resolution: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasSlaViolated ;
    sh:datatype xsd:integer ;
    sh:message "Sla Violated: type xsd:integer." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasSubmittedAt ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:message "Submitted At: required, type xsd:dateTime." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasResolvedAt ;
    sh:datatype xsd:dateTime ;
    sh:message "Resolved At: type xsd:dateTime." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasCreatedAt ;
    sh:datatype xsd:dateTime ;
    sh:message "Created At: type xsd:dateTime." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasUpdatedAt ;
    sh:datatype xsd:dateTime ;
    sh:message "Updated At: type xsd:dateTime." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :affectedResource ;
    sh:class :Resource ;
    sh:message "Affected Resource Id: reference to :Resource." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :affectedService ;
    sh:class :Service ;
    sh:message "Affected Service Id: reference to :Service." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :relatedAlarm ;
    sh:class :Alarm ;
    sh:message "Related Alarm Id: reference to :Alarm." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :raisedBy ;
    sh:class :Party ;
    sh:message "Raised By Id: reference to :Party." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :assignedTo ;
    sh:class :Party ;
    sh:message "Assigned To Id: reference to :Party." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :resolvedBy ;
    sh:class :Party ;
    sh:message "Resolved By Id: reference to :Party." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :sensitivityTier ;
    sh:minCount 1 ;
    sh:in ( :Public :Internal :Confidential :Restricted ) ;
    sh:message "Sensitivity tier annotation is required." ;
    sh:severity sh:Violation
  ] .


# ── UserRole ──────────────────────────────────────────
shapes:UserRoleShape
  a sh:NodeShape ;
  sh:targetClass :UserRole ;
  sh:property [
    sh:path :hasName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "Name: required, type xsd:string." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasDescription ;
    sh:datatype xsd:string ;
    sh:message "Description: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasPermissionSet ;
    sh:datatype xsd:string ;
    sh:message "Permission Set: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasCreatedAt ;
    sh:datatype xsd:dateTime ;
    sh:message "Created At: type xsd:dateTime." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :sensitivityTier ;
    sh:minCount 1 ;
    sh:in ( :Public :Internal :Confidential :Restricted ) ;
    sh:message "Sensitivity tier annotation is required." ;
    sh:severity sh:Violation
  ] .


# ── Agent Acceptance Gate: ObservationRecord ──────────────────────────
shapes:ObservationAcceptanceGate
  a sh:NodeShape ;
  sh:targetClass :ObservationRecord ;
  sh:property [
    sh:path prov:wasGeneratedBy ;
    sh:minCount 1 ;
    sh:message "Observation must carry prov:wasGeneratedBy (PROV-O required)." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path prov:generatedAtTime ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTime ;
    sh:message "Observation must carry prov:generatedAtTime timestamp." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasConfidenceScore ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 1.0 ;
    sh:message "Confidence score is required and must be 0.0–1.0." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :derivationMethod ;
    sh:minCount 1 ;
    sh:in ( "MEASURED" "INFERRED" "IMPORTED" "SYNTHESIZED" ) ;
    sh:message "Derivation method must be MEASURED, INFERRED, IMPORTED, or SYNTHESIZED." ;
    sh:severity sh:Violation
  ] .


# ── DomainEvent Completeness Gate ────────────────────────────────────
shapes:DomainEventCompletenessShape
  a sh:NodeShape ;
  sh:targetClass :DomainEvent ;
  sh:property [
    sh:path :hasParticipant ;
    sh:minCount 1 ;
    sh:class :Agent ;
    sh:message "Every DomainEvent must have at least one participant." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasEventStatus ;
    sh:minCount 1 ;
    sh:in ( "OPEN" "IN_PROGRESS" "COMPLETED" "FAILED" "CANCELLED" ) ;
    sh:message "Event status must be one of the defined values." ;
    sh:severity sh:Violation
  ] .


# ── EntityRefOrValue: Reference Form Validation ──────────────────────
shapes:EntityRefShape
  a sh:NodeShape ;
  sh:targetClass :EntityRef ;
  sh:property [
    sh:path :referredType ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "EntityRef (reference form) must carry @referredType." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :href ;
    sh:minCount 1 ;
    sh:datatype xsd:anyURI ;
    sh:message "EntityRef (reference form) must carry a href following /{apiRoot}/{resource}/{id}." ;
    sh:severity sh:Violation
  ] .

