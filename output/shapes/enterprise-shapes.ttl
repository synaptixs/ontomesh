@prefix :     <https://ontology.example.com/enterprise/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix shapes: <https://ontology.example.com/shapes/enterprise/> .



# ── Meta-shape: Sensitivity Annotation Required ───────────────────────
shapes:SensitivityAnnotationShape
  a sh:NodeShape ;
  sh:targetClass owl:Class ;
  sh:property [
    sh:path :sensitivityTier ;
    sh:minCount 1 ;
    sh:in ( :Public :Internal :Confidential :Restricted ) ;
    sh:message "Every OWL class must have a :sensitivityTier annotation." ;
    sh:severity sh:Violation
  ] .


# ── AgentRoles ──────────────────────────────────────────
shapes:AgentRolesShape
  a sh:NodeShape ;
  sh:targetClass :AgentRoles ;
  sh:property [
    sh:path :hasValidFrom ;
    sh:datatype xsd:string ;
    sh:message "Valid From: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasValidUntil ;
    sh:datatype xsd:string ;
    sh:message "Valid Until: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :agent ;
    sh:class :Agent ;
    sh:minCount 1 ;
    sh:message "Agent Id: required reference to :Agent." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :role ;
    sh:class :Role ;
    sh:minCount 1 ;
    sh:message "Role Id: required reference to :Role." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :scopeAsset ;
    sh:class :Asset ;
    sh:message "Scope Asset Id: reference to :Asset." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :sensitivityTier ;
    sh:minCount 1 ;
    sh:in ( :Public :Internal :Confidential :Restricted ) ;
    sh:message "Sensitivity tier annotation is required." ;
    sh:severity sh:Violation
  ] .


# ── Agent ──────────────────────────────────────────
shapes:AgentShape
  a sh:NodeShape ;
  sh:targetClass :Agent ;
  sh:property [
    sh:path :hasAgentIri ;
    sh:datatype xsd:anyURI ;
    sh:message "Agent IRI: type xsd:anyURI." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasName ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "Name: required, type xsd:string." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasAgentType ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:message "Agent Type: required, type xsd:string." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path :hasCredentialExpiry ;
    sh:datatype xsd:dateTime ;
    sh:message "Credential Expiry: type xsd:dateTime." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasAuthorizedTiers ;
    sh:datatype xsd:string ;
    sh:message "Authorized Tiers: type xsd:string." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasActive ;
    sh:datatype xsd:boolean ;
    sh:message "Active: type xsd:boolean." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :hasCreatedAt ;
    sh:datatype xsd:dateTime ;
    sh:message "Created At: type xsd:dateTime." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :org ;
    sh:class :Organization ;
    sh:message "Org Id: reference to :Organization." ;
    sh:severity sh:Warning
  ] ;
  sh:property [
    sh:path :sensitivityTier ;
    sh:minCount 1 ;
    sh:in ( :Public :Internal :Confidential :Restricted ) ;
    sh:message "Sensitivity tier annotation is required." ;
    sh:severity sh:Violation
  ] .


