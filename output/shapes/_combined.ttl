            sh:path :bundle ;
            sh:severity sh:Violation ],
        [ sh:class owl:Thing ;
            sh:message "Regulation Id: required reference to owl:Thing." ;
            sh:minCount 1 ;
            sh:path :regulation ;
            sh:severity sh:Violation ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
