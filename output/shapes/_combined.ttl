@prefix : <https://ontology.example.com/enterprise/> .
@prefix default1: <https://ontology.example.com/tmf/> .
@prefix drift: <https://ontology.example.com/enterprise/drift/> .
@prefix evo: <https://ontology.example.com/evolution/> .
@prefix fed: <https://ontology.example.com/federation/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://ontology.example.com/shapes/enterprise/> .
@prefix shapes1: <https://ontology.example.com/tmf/shapes/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:CalibrationDriftObservationShape a sh:NodeShape ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "Calibration score (ECE) must be in [0.0, 1.0]." ;
            sh:minInclusive 0.0 ;
            sh:path :metricValue ;
            sh:severity sh:Violation ] ;
    sh:targetClass :CalibrationDriftObservation .

:DriftObservationShape a sh:NodeShape ;
    rdfs:label "Drift Observation Shape" ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "metricValue is required and must be xsd:decimal." ;
            sh:minCount 1 ;
            sh:path :metricValue ;
            sh:severity sh:Violation ],
        [ sh:class :DriftMetricType ;
            sh:message "driftMetricType is required." ;
            sh:minCount 1 ;
            sh:path :driftMetricType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "baselinePeriod (ISO 8601 interval) is required." ;
            sh:minCount 1 ;
            sh:path :baselinePeriod ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "observationPeriod (ISO 8601 interval) is required." ;
            sh:minCount 1 ;
            sh:path :observationPeriod ;
            sh:severity sh:Violation ],
        [ sh:in ( "OK" "WARNING" "CRITICAL" ) ;
            sh:message "driftSeverity must be OK, WARNING, or CRITICAL." ;
            sh:path :driftSeverity ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "featureName must be a string." ;
            sh:path :featureName ;
            sh:severity sh:Warning ] ;
    sh:targetClass :DriftObservation .

:JSDriftObservationShape a sh:NodeShape ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "JS divergence must be in [0.0, 1.0]." ;
            sh:minInclusive 0.0 ;
            sh:path :metricValue ;
            sh:severity sh:Violation ] ;
    sh:targetClass :JSDriftObservation .

:PSIDriftObservationShape a sh:NodeShape ;
    sh:property [ sh:maxInclusive 1.0 ;
            sh:message "PSI value must be in [0.0, 1.0]." ;
            sh:minInclusive 0.0 ;
            sh:path :metricValue ;
            sh:severity sh:Violation ] ;
    sh:targetClass :PSIDriftObservation .

drift:shapes a owl:Ontology ;
    rdfs:label "Drift Detection SHACL Shapes" .

shapes:AgentCredentialShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Agent must carry a persistent IRI for provenance." ;
            sh:minCount 1 ;
            sh:path :hasAgentIri ;
            sh:severity sh:Violation ],
        [ sh:message "Agent must declare its authorized sensitivity tiers." ;
            sh:minCount 1 ;
            sh:path :authorizedTiers ;
            sh:severity sh:Violation ] ;
    sh:targetClass :Agent .

shapes:AgentRolesShape a sh:NodeShape ;
    sh:property [ sh:class :Asset ;
            sh:message "Scope Asset Id: reference to :Asset." ;
            sh:path :scopeAsset ;
            sh:severity sh:Warning ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Valid From: type xsd:string." ;
            sh:path :hasValidFrom ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Valid Until: type xsd:string." ;
            sh:path :hasValidUntil ;
            sh:severity sh:Warning ],
        [ sh:class :Agent ;
            sh:message "Agent Id: required reference to :Agent." ;
            sh:minCount 1 ;
            sh:path :agent ;
            sh:severity sh:Violation ],
        [ sh:class :Role ;
            sh:message "Role Id: required reference to :Role." ;
            sh:minCount 1 ;
            sh:path :role ;
            sh:severity sh:Violation ] ;
    sh:targetClass :AgentRoles .

shapes:AgentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Agent IRI: type xsd:anyURI." ;
            sh:path :hasAgentIri ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Name: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasName ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Agent Type: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasAgentType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Credential Expiry: type xsd:dateTime." ;
            sh:path :hasCredentialExpiry ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Authorized Tiers: type xsd:string." ;
            sh:path :hasAuthorizedTiers ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:boolean ;
            sh:message "Active: type xsd:boolean." ;
            sh:path :hasActive ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:class :Organization ;
            sh:message "Org Id: reference to :Organization." ;
            sh:path :org ;
            sh:severity sh:Warning ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :Agent .

shapes:AgreementShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Agreement Iri: type xsd:anyURI." ;
            sh:path :hasAgreementIri ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Name: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasName ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Agreement Type: type xsd:string." ;
            sh:path :hasAgreementType ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Description: type xsd:string." ;
            sh:path :hasDescription ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Status: type xsd:string." ;
            sh:path :hasStatus ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Valid From: type xsd:string." ;
            sh:path :hasValidFrom ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Valid Until: type xsd:string." ;
            sh:path :hasValidUntil ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:class :Party ;
            sh:message "Party A Id: reference to :Party." ;
            sh:path :partyA ;
            sh:severity sh:Warning ],
        [ sh:class :Party ;
            sh:message "Party B Id: reference to :Party." ;
            sh:path :partyB ;
            sh:severity sh:Warning ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :Agreement .

shapes:AlarmShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Alarm Iri: type xsd:anyURI." ;
            sh:path :hasAlarmIri ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Alarm Type: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasAlarmType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Perceived Severity: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasPerceivedSeverity ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Probable Cause: type xsd:string." ;
            sh:path :hasProbableCause ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Specific Problem: type xsd:string." ;
            sh:path :hasSpecificProblem ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Alarm State: type xsd:string." ;
            sh:path :hasAlarmState ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Raised At: required, type xsd:dateTime." ;
            sh:minCount 1 ;
            sh:path :hasRaisedAt ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Acknowledged At: type xsd:dateTime." ;
            sh:path :hasAcknowledgedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Cleared At: type xsd:dateTime." ;
            sh:path :hasClearedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:class :Resource ;
            sh:message "Source Resource Id: reference to :Resource." ;
            sh:path :sourceResource ;
            sh:severity sh:Warning ],
        [ sh:class :Alarm ;
            sh:message "Root Cause Alarm Id: reference to :Alarm." ;
            sh:path :rootCauseAlarm ;
            sh:severity sh:Warning ],
        [ sh:class :Party ;
            sh:message "Raised By Id: reference to :Party." ;
            sh:path :raisedBy ;
            sh:severity sh:Warning ],
        [ sh:class :Party ;
            sh:message "Acknowledged By Id: reference to :Party." ;
            sh:path :acknowledgedBy ;
            sh:severity sh:Warning ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :Alarm .

shapes:AssetShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "External Identifier: type xsd:string." ;
            sh:path :hasExternalId ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Name: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasName ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Location Code: type xsd:string." ;
            sh:path :hasLocationCode ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Asset Status: type xsd:string." ;
            sh:path :hasStatus ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Commissioned At: type xsd:dateTime." ;
            sh:path :hasCommissionedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Decommissioned At: type xsd:dateTime." ;
            sh:path :hasDecommissionedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Updated At: type xsd:dateTime." ;
            sh:path :hasUpdatedAt ;
            sh:severity sh:Warning ],
        [ sh:class :AssetType ;
            sh:message "Asset Type Id: required reference to :AssetType." ;
            sh:minCount 1 ;
            sh:path :asset ;
            sh:severity sh:Violation ],
        [ sh:class :Organization ;
            sh:message "Owner Org Id: reference to :Organization." ;
            sh:path :owner ;
            sh:severity sh:Warning ],
        [ sh:class :Organization ;
            sh:message "Operator Org Id: reference to :Organization." ;
            sh:path :operator ;
            sh:severity sh:Warning ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :Asset .

shapes:AssetTypeShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Code: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasCode ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Label: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasLabel ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Description: type xsd:string." ;
            sh:path :hasDescription ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Unit Of Measure: type xsd:string." ;
            sh:path :hasUnitOfMeasure ;
