        [ sh:datatype xsd:string ;
            sh:message "Status: type xsd:string." ;
            sh:path :hasStatus ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Retry Policy: type xsd:string." ;
            sh:path :hasRetryPolicy ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Last Delivered At: type xsd:dateTime." ;
            sh:path :hasLastDeliveredAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:integer ;
            sh:message "Delivery Failures: type xsd:integer." ;
            sh:path :hasDeliveryFailures ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Valid For Start: type xsd:string." ;
            sh:path :hasValidForStart ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Valid For End: type xsd:string." ;
            sh:path :hasValidForEnd ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
