    sh:targetClass :EventSubscription .

shapes:EvolutionApprovalGate a sh:NodeShape ;
    sh:property [ sh:message "Approved proposal must carry a reviewer_id." ;
            sh:path evo:reviewerId ;
            sh:severity sh:Violation ],
        [ sh:message "Approved proposal must carry a semver version_target (MAJOR.MINOR.PATCH)." ;
            sh:path evo:versionTarget ;
            sh:pattern "^\\d+\\.\\d+\\.\\d+$" ;
            sh:severity sh:Violation ] ;
    sh:sparql [ sh:message "Approved proposals require reviewer_id + version_target." ;
            sh:select """
      PREFIX evo: <https://ontology.example.com/evolution/>
      SELECT ?this WHERE {
        ?this evo:status "APPROVED" .
        FILTER NOT EXISTS { ?this evo:reviewerId ?r }
      }
    """ ] ;
    sh:targetClass evo:EvolutionProposal .

shapes:EvolutionProposalShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Every evolution proposal must carry a unique proposal_id (UUID)." ;
            sh:minCount 1 ;
            sh:path evo:proposalId ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:decimal ;
            sh:maxInclusive 1.0 ;
            sh:message "confidence_score must be a number between 0.0 and 1.0 inclusive." ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path evo:confidenceScore ;
            sh:severity sh:Violation ],
        [ sh:in ( "PENDING" "APPROVED" "REJECTED" "DEFERRED" ) ;
            sh:message "status must be one of PENDING/APPROVED/REJECTED/DEFERRED." ;
            sh:minCount 1 ;
            sh:path evo:status ;
            sh:severity sh:Violation ],
        [ sh:in ( "NEW_CLASS" "NEW_PROPERTY" "NEW_CONSTRAINT" "DEPRECATE" ) ;
            sh:message "proposal_type must be one of NEW_CLASS/NEW_PROPERTY/NEW_CONSTRAINT/DEPRECATE." ;
            sh:minCount 1 ;
            sh:path evo:proposalType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Proposal must include a proposed OWL axiom serialised as Turtle." ;
            sh:minCount 1 ;
            sh:minLength 10 ;
            sh:path evo:candidateTurtle ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Proposal must include the SPARQL query that surfaced the evidence." ;
            sh:minCount 1 ;
            sh:minLength 10 ;
            sh:path evo:evidenceSparql ;
            sh:severity sh:Violation ],
        [ sh:in ( "SHACL_VIOLATION_ACCUMULATION" "CARDINALITY_BREACH" "CLASS_COOCCURRENCE" "NLP_CANDIDATE_PROMOTION" ) ;
            sh:message "detection_strategy must be one of the four monitor strategies." ;
            sh:minCount 1 ;
            sh:path evo:detectionStrategy ;
            sh:severity sh:Violation ] ;
    sh:targetClass evo:EvolutionProposal .

shapes:FederatedResultShape a sh:NodeShape ;
    sh:property [ sh:in ( "Public" "Internal" "Confidential" "Restricted" ) ;
            sh:message "Federated result must declare a sensitivity tier." ;
            sh:minCount 1 ;
            sh:path fed:sensitivityTier ;
            sh:severity sh:Violation ],
        [ sh:message "Federated result must be attributed to the partner's agent IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasAttributedTo ;
            sh:severity sh:Violation ],
        [ sh:message "Federated result must name the source partner IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path fed:sourcePartner ;
            sh:severity sh:Violation ] ;
    sh:sparql [ sh:message "RESTRICTED-tier data MUST NOT cross the federation boundary." ;
            sh:select """
      PREFIX fed: <https://ontology.example.com/federation/>
      SELECT ?this ?tier WHERE {
        ?this fed:sensitivityTier ?tier .
        FILTER (?tier = "Restricted")
      }
    """ ] ;
    sh:targetClass fed:FederatedResult .

shapes:FederationPartnerShape a sh:NodeShape ;
    sh:property [ sh:message "Partner SPARQL endpoint must be HTTPS." ;
            sh:minCount 1 ;
            sh:path fed:sparqlEndpoint ;
            sh:pattern "^https://" ;
            sh:severity sh:Violation ],
        [ sh:in ( "PROPOSED" "HANDSHAKE_SENT" "COUNTERSIGNED" "ACTIVE" "EXPIRED" "REVOKED" ) ;
            sh:message "Partner trust_state must be one of the six enumerated values." ;
            sh:minCount 1 ;
            sh:path fed:trustState ;
            sh:severity sh:Violation ],
        [ sh:in ( "Public" "Internal" "Confidential" ) ;
            sh:message "Partner maxShareableTier cannot exceed Confidential (Restricted is never federable)." ;
            sh:minCount 1 ;
            sh:path fed:maxShareableTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass fed:Partner .

shapes:FederationPartnersShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Partner Iri: required, type xsd:anyURI." ;
            sh:minCount 1 ;
            sh:path :hasPartnerIri ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Display Name: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasDisplayName ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Sparql Endpoint: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasSparqlEndpoint ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Manifest Url: type xsd:string." ;
            sh:path :hasManifestUrl ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Manifest Jsonld: type xsd:string." ;
            sh:path :hasManifestJsonld ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Manifest Signature: type xsd:string." ;
            sh:path :hasManifestSignature ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Public Key: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasPublicKey ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Exposed Classes: type xsd:string." ;
            sh:path :hasExposedClasses ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Max Shareable Tier: type xsd:string." ;
            sh:path :hasMaxShareableTier ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Trust State: type xsd:string." ;
            sh:path :hasTrustState ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Valid From: type xsd:string." ;
            sh:path :hasValidFrom ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Valid Until: type xsd:string." ;
            sh:path :hasValidUntil ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Registered At: type xsd:dateTime." ;
            sh:path :hasRegisteredAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Updated At: type xsd:dateTime." ;
            sh:path :hasUpdatedAt ;
