shapes:AttachmentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Name: type xsd:string." ;
            sh:path :hasName ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Description: type xsd:string." ;
            sh:path :hasDescription ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Mime Type: type xsd:string." ;
            sh:path :hasMimeType ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Url: type xsd:string." ;
            sh:path :hasUrl ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Attachment Type: type xsd:string." ;
            sh:path :hasAttachmentType ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Owner Type: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasOwnerType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:class owl:Thing ;
            sh:message "Owner Id: required reference to owl:Thing." ;
            sh:minCount 1 ;
            sh:path :owner ;
            sh:severity sh:Violation ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :Attachment .

shapes:CapabilityManifestShape a sh:NodeShape ;
    sh:property [ sh:message "Manifest must name the ontology IRI it exposes." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path fed:ontologyIri ;
            sh:severity sh:Violation ],
        [ sh:message "Manifest must list at least one exposed OWL class." ;
            sh:minCount 1 ;
            sh:path fed:exposedClasses ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Manifest must embed the signer's public key." ;
            sh:minCount 1 ;
            sh:minLength 32 ;
            sh:path fed:publicKey ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Manifest must carry an Ed25519 signature." ;
            sh:minCount 1 ;
            sh:minLength 40 ;
            sh:path fed:signature ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Manifest must declare an expiry timestamp." ;
            sh:minCount 1 ;
            sh:path fed:validUntil ;
            sh:severity sh:Violation ],
        [ sh:in ( "Ed25519" ) ;
            sh:message "Only Ed25519 signatures are accepted at the boundary." ;
            sh:path fed:signatureAlgorithm ;
            sh:severity sh:Violation ] ;
    sh:targetClass fed:CapabilityManifest .

