shapes:CustomerAccountShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Account Iri: type xsd:anyURI." ;
            sh:path :hasAccountIri ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Account Number: type xsd:string." ;
            sh:path :hasAccountNumber ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Name: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasName ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Account Type: type xsd:string." ;
            sh:path :hasAccountType ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Status: type xsd:string." ;
            sh:path :hasStatus ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:decimal ;
            sh:message "Credit Limit: type xsd:decimal." ;
            sh:path :hasCreditLimit ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Currency Code: type xsd:string." ;
            sh:path :hasCurrencyCode ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:class :Party ;
            sh:message "Party Id: required reference to :Party." ;
            sh:minCount 1 ;
            sh:path :party ;
            sh:severity sh:Violation ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :CustomerAccount .

shapes:CustomerBillShape a sh:NodeShape ;
