            sh:minCount 1 ;
            sh:path :hasParticipationRole ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Joined At: type xsd:dateTime." ;
            sh:path :hasJoinedAt ;
            sh:severity sh:Warning ],
        [ sh:class :DomainEvent ;
            sh:message "Event Id: required reference to :DomainEvent." ;
            sh:minCount 1 ;
            sh:path :event ;
            sh:severity sh:Violation ],
        [ sh:class :Agent ;
            sh:message "Agent Id: required reference to :Agent." ;
            sh:minCount 1 ;
            sh:path :agent ;
            sh:severity sh:Violation ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :EventParticipants .

shapes:EventSubscriptionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Subscription Iri: type xsd:anyURI." ;
            sh:path :hasSubscriptionIri ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Event Type: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasEventType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
