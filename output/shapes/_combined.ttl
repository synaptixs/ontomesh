            sh:path :hasDisputeReason ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Bill Document Url: type xsd:string." ;
            sh:path :hasBillDocumentUrl ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Updated At: type xsd:dateTime." ;
            sh:path :hasUpdatedAt ;
            sh:severity sh:Warning ],
        [ sh:class :CustomerAccount ;
            sh:message "Customer Account Id: required reference to :CustomerAccount." ;
            sh:minCount 1 ;
            sh:path :customerAccount ;
            sh:severity sh:Violation ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :CustomerBill .

shapes:DomainEventCompletenessShape a sh:NodeShape ;
    sh:property [ sh:class :Agent ;
            sh:message "Every DomainEvent must have at least one participant." ;
            sh:minCount 1 ;
            sh:path :hasParticipant ;
            sh:severity sh:Violation ],
        [ sh:in ( "OPEN" "IN_PROGRESS" "COMPLETED" "FAILED" "CANCELLED" ) ;
            sh:message "Event status must be one of the defined values." ;
            sh:minCount 1 ;
            sh:path :hasEventStatus ;
            sh:severity sh:Violation ] ;
    sh:targetClass :DomainEvent .

shapes:DomainEventShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "Event Iri: type xsd:anyURI." ;
            sh:path :hasEventIri ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Event Type: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasEventType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Title: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasTitle ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Description: type xsd:string." ;
            sh:path :hasDescription ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Status: type xsd:string." ;
            sh:path :hasStatus ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:string ;
            sh:message "Outcome: type xsd:string." ;
            sh:path :hasOutcome ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Started At: type xsd:dateTime." ;
            sh:path :hasStartedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Completed At: type xsd:dateTime." ;
            sh:path :hasCompletedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Created At: type xsd:dateTime." ;
            sh:path :hasCreatedAt ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:dateTime ;
            sh:message "Updated At: type xsd:dateTime." ;
            sh:path :hasUpdatedAt ;
            sh:severity sh:Warning ],
        [ sh:class :Asset ;
            sh:message "Asset Id: reference to :Asset." ;
            sh:path :asset ;
            sh:severity sh:Warning ],
        [ sh:class :Agent ;
            sh:message "Initiated By: reference to :Agent." ;
            sh:path :initiatedBy ;
            sh:severity sh:Warning ],
        [ sh:class :Policy ;
            sh:message "Policy Id: reference to :Policy." ;
            sh:path :policy ;
            sh:severity sh:Warning ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ] ;
    sh:targetClass :DomainEvent .

shapes:EmbeddingIndexesShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:message "Updated At: type xsd:dateTime." ;
            sh:path :hasUpdatedAt ;
            sh:severity sh:Warning ],
        [ sh:class owl:Thing ;
            sh:message "Model Id: required reference to owl:Thing." ;
            sh:minCount 1 ;
            sh:path :model ;
            sh:severity sh:Violation ],
        [ sh:in ( :Public :Internal :Confidential :Restricted ) ;
            sh:message "Sensitivity tier annotation is required." ;
            sh:minCount 1 ;
            sh:path :sensitivityTier ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Index Name: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasIndexName ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Flavor: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasFlavor ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "Vector Store: required, type xsd:string." ;
            sh:minCount 1 ;
            sh:path :hasVectorStore ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
