shapes1:AlarmClearedAtShape a sh:NodeShape ;
    rdfs:comment "Tier-1: Cleared alarm must have a cleared_at timestamp." ;
    sh:sparql [ sh:message "AlarmClearedAtConsistency — Cleared alarm must have a cleared_at timestamp." ;
            sh:prefixes default1: ;
            sh:select "SELECT $this WHERE { $this :hasAlarmState \"Cleared\" . FILTER NOT EXISTS { $this :clearedAt ?t } }" ;
            sh:severity sh:Violation ] ;
    sh:targetClass default1:Alarm .

shapes1:ConflictEventShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "ConflictEvent must reference at least one assertion IRI (assertionAIri)." ;
            sh:minCount 1 ;
            sh:path default1:assertionAIri ;
            sh:severity sh:Violation ],
        [ sh:message "conflictType must be one of the allowed values." ;
            sh:minCount 1 ;
            sh:path default1:conflictType ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:integer ;
            sh:message "resolutionTier must be 1, 2, or 3." ;
            sh:path default1:resolutionTier ;
            sh:severity sh:Warning ] ;
    sh:targetClass default1:ConflictEvent .

shapes1:EventSubscriptionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:message "EventSubscription must have a callbackUrl." ;
            sh:minCount 1 ;
            sh:path default1:callbackUrl ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:message "EventSubscription must specify an eventType." ;
            sh:minCount 1 ;
            sh:path default1:eventType ;
            sh:severity sh:Violation ] ;
    sh:targetClass default1:EventSubscription .

shapes1:ResourceStateConsistencyShape a sh:NodeShape ;
    rdfs:comment "Tier-1: operational_state=Disabled must not coexist with admin_state=Unlocked." ;
    sh:sparql [ sh:message "OperationalAndAdminStateConsistency — Disabled resource must not be Unlocked." ;
            sh:prefixes default1: ;
            sh:select "SELECT $this WHERE { $this :hasOperationalState \"Disabled\" ; :hasAdminState \"Unlocked\" . }" ;
            sh:severity sh:Violation ] ;
    sh:targetClass default1:Resource .

shapes1:TroubleTicketResolvedShape a sh:NodeShape ;
    rdfs:comment "Tier-1: Resolved/Closed ticket must have resolved_at." ;
    sh:sparql [ sh:message "TroubleTicketResolvedAtConsistency — Resolved or Closed ticket must have resolved_at." ;
            sh:prefixes default1: ;
            sh:select "SELECT $this WHERE { $this :hasTicketStatus ?s . FILTER(?s IN (\"Resolved\",\"Closed\")) FILTER NOT EXISTS { $this :resolvedAt ?t } }" ;
            sh:severity sh:Violation ] ;
    sh:targetClass default1:TroubleTicket .

