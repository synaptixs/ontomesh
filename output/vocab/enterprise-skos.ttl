  skos:altLabel "Account" ;
  skos:altLabel "Billing Account" ;
  skos:definition "A billing and service management account per TMF666." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :CustomerAccount .

:NoteConcept
  a skos:Concept ;
  skos:prefLabel "Note" ;
  skos:definition "A free-text annotation linked to any TMF entity per SID Common ABE." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Note .

:PartyConcept
  a skos:Concept ;
  skos:prefLabel "Party" ;
  skos:altLabel "Individual" ;
  skos:altLabel "Organization" ;
  skos:altLabel "Customer" ;
  skos:altLabel "Partner" ;
  skos:definition "An individual or organisation that plays a role in the business (TMF632)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Party .

:PartyRoleConcept
  a skos:Concept ;
  skos:prefLabel "Party Role" ;
  skos:altLabel "Role" ;
  skos:altLabel "Function" ;
  skos:altLabel "Relationship" ;
  skos:definition "A contextual role a party plays, such as Customer or Partner (TMF669)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :PartyRole .

:PerformanceIndicatorConcept
  a skos:Concept ;
  skos:prefLabel "Performance Indicator" ;
  skos:altLabel "KPI" ;
  skos:altLabel "Metric" ;
  skos:altLabel "Measurement" ;
  skos:altLabel "Observation" ;
  skos:definition "A KPI measurement or ML-derived metric with PROV-O provenance." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :PerformanceIndicator .

:GeographicLocationConcept
  a skos:Concept ;
  skos:prefLabel "Geographic Place" ;
  skos:altLabel "Location" ;
  skos:altLabel "Address" ;
  skos:altLabel "Site" ;
  skos:definition "A geographic location, address, or site per TMF673/674/675." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :GeographicLocation .

:PolicyConcept
  a skos:Concept ;
  skos:prefLabel "Policy" ;
  skos:altLabel "Rule" ;
  skos:altLabel "Regulation" ;
  skos:altLabel "Standard" ;
  skos:altLabel "SLA Policy" ;
  skos:definition "A rule or constraint governing operations, network, or compliance." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Policy .

:ProductConcept
  a skos:Concept ;
  skos:prefLabel "Product" ;
  skos:altLabel "Subscribed Product" ;
  skos:altLabel "Active Subscription" ;
  skos:definition "A product instance subscribed to by a party per TMF637." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Product .

:ProductOfferingConcept
  a skos:Concept ;
  skos:prefLabel "Product Offering" ;
  skos:altLabel "Commercial Offer" ;
  skos:altLabel "Tariff Plan" ;
  skos:definition "A commercial offering available to customers per TMF620." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ProductOffering .

:ProductOrderConcept
  a skos:Concept ;
  skos:prefLabel "Product Order" ;
  skos:altLabel "Customer Order" ;
  skos:altLabel "Service Request" ;
  skos:definition "A customer request to provision, modify, or terminate a product (TMF622)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ProductOrder .

:ProductSpecificationConcept
  a skos:Concept ;
  skos:prefLabel "Product Specification" ;
  skos:altLabel "Product Template" ;
  skos:altLabel "Product Catalog Entry" ;
  skos:definition "Specification of a product type per SID Product domain/TMF620." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ProductSpecification .

:ResourceConcept
  a skos:Concept ;
  skos:prefLabel "Resource" ;
  skos:altLabel "Network Element" ;
  skos:altLabel "Network Function" ;
  skos:altLabel "Physical Asset" ;
  skos:definition "A logical or physical telecom resource instance (TMF639). Covers NetworkFunction, Equipment, IPAddress." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Resource .

:ResourceRelationshipConcept
  a skos:Concept ;
  skos:prefLabel "Resource Relationship" ;
  skos:altLabel "Resource Association" ;
  skos:altLabel "Network Topology Link" ;
  skos:definition "Typed association between two resources (composedOf, connectsTo, dependsOn)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ResourceRelationship .

:ResourceSpecificationConcept
  a skos:Concept ;
  skos:prefLabel "Resource Specification" ;
  skos:altLabel "Resource Template" ;
  skos:altLabel "Resource Catalog Entry" ;
  skos:definition "Catalog template for a resource type. Specification pattern per SID/TMF634." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ResourceSpecification .

:ServiceConcept
  a skos:Concept ;
  skos:prefLabel "Service" ;
  skos:altLabel "Customer Facing Service" ;
  skos:altLabel "Resource Facing Service" ;
  skos:definition "An active service instance in the service inventory (TMF638). Covers CFS and RFS." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Service .

:ServiceOrderConcept
  a skos:Concept ;
  skos:prefLabel "Service Order" ;
  skos:altLabel "Fulfilment Order" ;
  skos:altLabel "Provisioning Order" ;
  skos:definition "An internal fulfilment order to provision or modify a service (TMF641)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ServiceOrder .

:ServiceProblemConcept
  a skos:Concept ;
  skos:prefLabel "Service Problem" ;
  skos:altLabel "Trouble Ticket" ;
  skos:altLabel "Incident" ;
  skos:altLabel "Fault Report" ;
  skos:definition "A service quality or availability problem raised against a customer service (TMF656)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ServiceProblem .

:ServiceSpecificationConcept
  a skos:Concept ;
  skos:prefLabel "Service Specification" ;
  skos:altLabel "Service Template" ;
  skos:altLabel "Service Catalog Entry" ;
  skos:definition "Catalog definition of a service type. Specification pattern per SID/TMF633." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ServiceSpecification .

:UserRoleConcept
  a skos:Concept ;
  skos:prefLabel "User Role" ;
  skos:definition "A named permission set for users per SID Enterprise ABE / TMF672." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :UserRole .


