<https://ontology.example.com/vocab/enterprise/>
  a skos:ConceptScheme ;
  skos:prefLabel "Enterprise Domain Vocabulary" ;
  rdfs:comment "Controlled vocabulary for the enterprise domain ontology. "
               "Covers preferred labels, synonyms, and deprecated terms." ;
  dcterms:creator "Ontology Toolkit — Auto-generated from ontology_metadata" .


# ── Concept per Domain Class ────────────────────────────────────────

:AgentRolesConcept
  a skos:Concept ;
  skos:prefLabel "Agent Roles" ;
  skos:definition "Vocabulary concept for Agent Roles." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :AgentRoles .

:AgentConcept
  a skos:Concept ;
  skos:prefLabel "Agent" ;
  skos:altLabel "Actor" ;
  skos:altLabel "System Agent" ;
  skos:altLabel "Sensor" ;
  skos:definition "A human, system, AI agent, or sensor that produces or acts on domain facts." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Agent .

:AssetTypeConcept
  a skos:Concept ;
  skos:prefLabel "Asset Type" ;
  skos:altLabel "Asset Category" ;
  skos:altLabel "Resource Class" ;
  skos:definition "A classification category for managed assets." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :AssetType .

:AssetConcept
  a skos:Concept ;
  skos:prefLabel "Asset" ;
  skos:altLabel "Resource" ;
  skos:altLabel "Managed Object" ;
  skos:altLabel "Network Element" ;
  skos:definition "A physical or logical resource managed by the organization." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Asset .

:DomainEventConcept
  a skos:Concept ;
  skos:prefLabel "Domain Event" ;
  skos:altLabel "Operation" ;
  skos:altLabel "Activity" ;
  skos:altLabel "Incident" ;
  skos:altLabel "Inspection" ;
  skos:definition "A significant occurrence in the domain that changes state or produces evidence." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :DomainEvent .

:EventParticipantsConcept
  a skos:Concept ;
  skos:prefLabel "Event Participants" ;
  skos:definition "Vocabulary concept for Event Participants." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :EventParticipants .

:ObservationRecordConcept
  a skos:Concept ;
  skos:prefLabel "Observation" ;
  skos:altLabel "Measurement" ;
  skos:altLabel "Reading" ;
  skos:altLabel "Detection" ;
  skos:altLabel "Finding" ;
  skos:definition "A measured, computed, or imported fact about an asset or event, with provenance." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :ObservationRecord .

:OrganizationConcept
  a skos:Concept ;
  skos:prefLabel "Organization" ;
  skos:altLabel "Enterprise" ;
  skos:altLabel "Company" ;
  skos:altLabel "Entity" ;
  skos:definition "A legal or operational entity that owns, operates, or governs assets." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Organization .

:PolicyConcept
  a skos:Concept ;
  skos:prefLabel "Policy" ;
  skos:altLabel "Rule" ;
  skos:altLabel "Standard" ;
  skos:altLabel "SLA" ;
  skos:definition "A rule or constraint that governs asset operations and agent behaviour." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Policy .

:PolicyApplicationConcept
  a skos:Concept ;
  skos:prefLabel "Policy Application" ;
  skos:altLabel "Compliance Check" ;
  skos:altLabel "Audit Record" ;
  skos:definition "Records the application of a policy to an event or asset with outcome." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :PolicyApplication .

:RoleConcept
  a skos:Concept ;
  skos:prefLabel "Role" ;
  skos:altLabel "Function" ;
  skos:altLabel "Responsibility" ;
  skos:definition "A contextual function an agent performs in a specific scope." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Role .

:AgreementConcept
  a skos:Concept ;
  skos:prefLabel "Agreement" ;
  skos:altLabel "SLA" ;
  skos:altLabel "Contract" ;
  skos:altLabel "Service Level Agreement" ;
  skos:definition "A commercial, SLA, or roaming agreement between parties (TMF651)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Agreement .

:AlarmConcept
  a skos:Concept ;
  skos:prefLabel "Alarm" ;
  skos:altLabel "Fault" ;
  skos:altLabel "Notification" ;
  skos:altLabel "Alert" ;
  skos:definition "A network fault notification raised by a network function or element (TMF642)." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Alarm .

:AttachmentConcept
  a skos:Concept ;
  skos:prefLabel "Attachment" ;
  skos:definition "A file or URL attachment linked to any TMF entity per SID Common ABE." ;
  skos:inScheme <https://ontology.example.com/vocab/enterprise/> ;
  skos:exactMatch :Attachment .

:CharacteristicConcept
  a skos:Concept ;
