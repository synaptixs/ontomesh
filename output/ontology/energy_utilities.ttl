  :sensitivityTier :Internal .

:GridKPI
  a owl:Class ;
  rdfs:label "Grid KPI" ;
  rdfs:comment "Reliability and performance indicators for grid operations (SAIDI, SAIFI, CAIDI)." ;
  owl:equivalentClass <cim:PerformanceIndex> ;
  :sensitivityTier :Public .

:kpi_id
