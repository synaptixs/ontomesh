ind:VoltageExcursion
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Voltage Excursion" ;
  rdfs:comment "Voltage exceeds or falls below acceptable operational limits." ;
  :sensitivityTier :Internal .

ind:FrequencyDeviation
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Frequency Deviation" ;
  rdfs:comment "Grid frequency deviates from nominal (50/60 Hz)." ;
  :sensitivityTier :Internal .

ind:TheftDetectionAlert
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Theft Detection Alert" ;
  rdfs:comment "Statistical anomaly in meter readings suggesting energy theft." ;
  :sensitivityTier :Confidential .

ind:AssetMaintenanceEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Asset Maintenance Event" ;
  rdfs:comment "Scheduled or reactive maintenance on a power asset." ;
  :sensitivityTier :Internal .

<https://ontology.example.com/energy/>
  rdfs:comment "Relationship (unformalised): A PowerAsset belongs to exactly one GridTopology connectivity node." ;
  rdfs:comment "Relationship (unformalised): An EnergyMeter measures one or more PowerAssets." ;
  rdfs:comment "Relationship (unformalised): An EnergyReading is produced by exactly one EnergyMeter." ;
  rdfs:comment "Relationship (unformalised): An OutageEvent affects one or more PowerAssets." ;
  rdfs:comment "Relationship (unformalised): A RenewableAsset is a specialisation of PowerAsset." ;
  rdfs:comment "Relationship (unformalised): A GridKPI is computed from one or more OutageEvents within a measurement period." ;
  rdfs:comment "Relationship (unformalised): An EnergyMarketTransaction is associated with one PowerAsset (generation unit or load)."  .
