  rdfs:label "From Asset Id" ;
  :sensitivityTier :Internal .

:to_asset_id
  a owl:ObjectProperty ;
  rdfs:domain :GridTopology ;
  rdfs:range :PowerAsset ;
  rdfs:label "To Asset Id" ;
  :sensitivityTier :Internal .

:connection_type
  a owl:DatatypeProperty ;
  rdfs:domain :GridTopology ;
  rdfs:range xsd:string ;
  rdfs:label "Connection Type" ;
  :sensitivityTier :Internal .

:nominal_voltage_kv
