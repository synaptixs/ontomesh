@prefix :      <https://ontology.example.com/enterprise/> .
@prefix ind:   <https://ontology.example.com/logistics/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://ontology.example.com/logistics/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/logistics/1.0.0> ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Logistics & Supply Chain Ontology Module" ;
  rdfs:comment "Domain template for freight, warehousing, last-mile delivery, and supply chain visibility. Suitable for 3PL providers, e-commerce fulfillment, cold chain, and customs/trade compliance." ;
  dcterms:created "2026-07-26T17:44:01Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit Phase 3 — auto-generated from template" .


ind:Shipment
  a owl:Class ;
  rdfs:label "Shipment" ;
  rdfs:comment "A collection of goods being transported from origin to destination." ;
  owl:equivalentClass <https://schema.org/ParcelDelivery> ;
  :sensitivityTier :Internal .

ind:Package
  a owl:Class ;
  rdfs:label "Package" ;
  rdfs:comment "An individual physical container within a shipment." ;
  owl:equivalentClass <https://www.gs1.org/voc/Logistic_Unit> ;
  :sensitivityTier :Internal .

ind:Facility
  a owl:Class ;
  rdfs:label "Facility" ;
  rdfs:comment "A warehouse, distribution centre, port, airport, or retail fulfilment location." ;
  :sensitivityTier :Internal .

ind:Carrier
  a owl:Class ;
  rdfs:label "Carrier" ;
  rdfs:comment "A transport service provider (airline, road freight, rail, ocean liner)." ;
  :sensitivityTier :Internal .

ind:Order
  a owl:Class ;
  rdfs:label "Customer Order" ;
  rdfs:comment "A customer purchase order that triggers fulfilment and shipment creation." ;
  owl:equivalentClass <https://schema.org/Order> ;
  :sensitivityTier :Confidential .

ind:InventoryItem
  a owl:Class ;
  rdfs:label "Inventory Item" ;
  rdfs:comment "A SKU held in a facility at a point in time." ;
  owl:equivalentClass <https://www.gs1.org/voc/Product> ;
  :sensitivityTier :Internal .

ind:TrackingEvent
  a owl:Class ;
  rdfs:label "Tracking Event" ;
  rdfs:comment "A scan event recording the location and status of a shipment or package." ;
  :sensitivityTier :Internal .

ind:CustomsDeclaration
  a owl:Class ;
  rdfs:label "Customs Declaration" ;
  rdfs:comment "Cross-border customs entry declaration for international shipments." ;
  :sensitivityTier :Restricted .

ind:shipment_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:CustomsDeclaration ind:Package ind:Shipment ind:TrackingEvent ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Shipment Id" ;
  :sensitivityTier :Restricted .

ind:tracking_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range xsd:string ;
  rdfs:label "Tracking Number" ;
  :sensitivityTier :Internal .

ind:origin_facility_id
  a owl:ObjectProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range ind:Facility ;
  rdfs:label "Origin Facility Id" ;
  :sensitivityTier :Internal .

ind:destination_facility_id
  a owl:ObjectProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range ind:Facility ;
  rdfs:label "Destination Facility Id" ;
  :sensitivityTier :Internal .

ind:carrier_id
  a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Carrier ind:Shipment ) ] ;
  rdfs:range ind:Carrier ;
  rdfs:label "Carrier Id" ;
  :sensitivityTier :Internal .

ind:service_level
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "SameDay" "NextDay" "Standard" "Economy" "Freight" ) ] ;
  rdfs:label "Service Level" ;
  :sensitivityTier :Internal .

ind:shipment_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Created" "PickedUp" "InTransit" "OutForDelivery" "Delivered" "Returned" "Exception" ) ] ;
  rdfs:label "Shipment Status" ;
  :sensitivityTier :Internal .

ind:estimated_delivery
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Estimated Delivery" ;
  :sensitivityTier :Internal .

ind:actual_delivery
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Actual Delivery" ;
  :sensitivityTier :Internal .

ind:gross_weight_kg
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range xsd:decimal ;
  rdfs:label "Gross Weight Kg" ;
  :sensitivityTier :Internal .

ind:declared_value
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range xsd:decimal ;
  rdfs:label "Declared Value" ;
  :sensitivityTier :Internal .

ind:incoterms
  a owl:DatatypeProperty ;
  rdfs:domain ind:Shipment ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "EXW" "FCA" "CPT" "CIP" "DAP" "DPU" "DDP" "FAS" "FOB" "CFR" "CIF" ) ] ;
  rdfs:label "Incoterms" ;
  :sensitivityTier :Internal .

ind:package_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range xsd:string ;
  rdfs:label "Package Id" ;
  :sensitivityTier :Internal .

ind:sscc
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range xsd:string ;
  rdfs:label "Sscc" ;
  rdfs:comment "GS1 Serial Shipping Container Code" ;
  :sensitivityTier :Internal .

ind:package_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Box" "Pallet" "Envelope" "Drum" "Crate" "Bag" "Bundle" ) ] ;
  rdfs:label "Package Type" ;
  :sensitivityTier :Internal .

ind:weight_kg
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range xsd:decimal ;
  rdfs:label "Weight Kg" ;
  :sensitivityTier :Internal .

ind:length_cm
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range xsd:decimal ;
  rdfs:label "Length Cm" ;
  :sensitivityTier :Internal .

ind:width_cm
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range xsd:decimal ;
  rdfs:label "Width Cm" ;
  :sensitivityTier :Internal .

ind:height_cm
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range xsd:decimal ;
  rdfs:label "Height Cm" ;
  :sensitivityTier :Internal .

ind:is_hazmat
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range xsd:boolean ;
  rdfs:label "Is Hazmat" ;
  :sensitivityTier :Internal .

ind:temperature_requirement
  a owl:DatatypeProperty ;
  rdfs:domain ind:Package ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Ambient" "Chilled" "Frozen" "Controlled" ) ] ;
  rdfs:label "Temperature Requirement" ;
  :sensitivityTier :Internal .

ind:facility_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Facility ind:InventoryItem ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Facility Id" ;
  :sensitivityTier :Internal .

ind:facility_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:Facility ;
  rdfs:range xsd:string ;
  rdfs:label "Facility Name" ;
  :sensitivityTier :Internal .

ind:facility_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Facility ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Warehouse" "DistributionCenter" "Port" "Airport" "CrossDock" "RetailStore" "CustomerAddress" ) ] ;
  rdfs:label "Facility Type" ;
  :sensitivityTier :Internal .

ind:address
  a owl:DatatypeProperty ;
  rdfs:domain ind:Facility ;
  rdfs:range xsd:string ;
  rdfs:label "Address" ;
  :sensitivityTier :Internal .

ind:country_code
  a owl:DatatypeProperty ;
  rdfs:domain ind:Facility ;
  rdfs:range xsd:string ;
  rdfs:label "Country Code" ;
  :sensitivityTier :Internal .

ind:geo_location
  a owl:DatatypeProperty ;
  rdfs:domain ind:Facility ;
  rdfs:range xsd:string ;
  rdfs:label "Geo Location" ;
  rdfs:comment "WKT POINT" ;
  :sensitivityTier :Internal .

ind:capacity_sqm
  a owl:DatatypeProperty ;
  rdfs:domain ind:Facility ;
  rdfs:range xsd:decimal ;
  rdfs:label "Capacity Sqm" ;
  :sensitivityTier :Internal .

ind:operator_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Facility ;
  rdfs:range xsd:string ;
  rdfs:label "Operator Id" ;
  :sensitivityTier :Internal .

ind:carrier_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:Carrier ;
  rdfs:range xsd:string ;
  rdfs:label "Carrier Name" ;
  :sensitivityTier :Internal .

ind:carrier_scac
  a owl:DatatypeProperty ;
  rdfs:domain ind:Carrier ;
  rdfs:range xsd:string ;
  rdfs:label "Carrier Scac" ;
  rdfs:comment "Standard Carrier Alpha Code" ;
  :sensitivityTier :Internal .

ind:carrier_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Carrier ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Road" "Rail" "Air" "Ocean" "Intermodal" "Courier" ) ] ;
  rdfs:label "Carrier Type" ;
  :sensitivityTier :Internal .

ind:is_preferred
  a owl:DatatypeProperty ;
  rdfs:domain ind:Carrier ;
  rdfs:range xsd:boolean ;
  rdfs:label "Is Preferred" ;
  :sensitivityTier :Internal .

ind:order_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range xsd:string ;
  rdfs:label "Order Id" ;
  :sensitivityTier :Confidential .

ind:customer_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range xsd:string ;
  rdfs:label "Customer Id" ;
  :sensitivityTier :Confidential .

ind:order_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Order Date" ;
  :sensitivityTier :Confidential .

ind:order_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Pending" "Processing" "Shipped" "Delivered" "Cancelled" "Returned" ) ] ;
  rdfs:label "Order Status" ;
  :sensitivityTier :Confidential .

ind:total_value
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range xsd:decimal ;
  rdfs:label "Total Value" ;
  :sensitivityTier :Confidential .

ind:currency
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range xsd:string ;
  rdfs:label "Currency" ;
  :sensitivityTier :Confidential .

ind:priority_flag
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range xsd:boolean ;
  rdfs:label "Priority Flag" ;
  :sensitivityTier :Confidential .

ind:channel
  a owl:DatatypeProperty ;
  rdfs:domain ind:Order ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "eCommerce" "EDI" "Manual" "Marketplace" "API" ) ] ;
  rdfs:label "Channel" ;
  :sensitivityTier :Confidential .

ind:inventory_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:string ;
  rdfs:label "Inventory Id" ;
  :sensitivityTier :Internal .

ind:sku
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:string ;
  rdfs:label "Sku" ;
  :sensitivityTier :Internal .

ind:quantity_on_hand
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:integer ;
  rdfs:label "Quantity On Hand" ;
  :sensitivityTier :Internal .

ind:quantity_reserved
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:integer ;
  rdfs:label "Quantity Reserved" ;
  :sensitivityTier :Internal .

ind:reorder_point
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:integer ;
  rdfs:label "Reorder Point" ;
  :sensitivityTier :Internal .

ind:unit_cost
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:decimal ;
  rdfs:label "Unit Cost" ;
  :sensitivityTier :Internal .

ind:expiry_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:date ;
  rdfs:label "Expiry Date" ;
  :sensitivityTier :Internal .

ind:lot_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:InventoryItem ;
  rdfs:range xsd:string ;
  rdfs:label "Lot Number" ;
  :sensitivityTier :Internal .

ind:event_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:TrackingEvent ;
  rdfs:range xsd:string ;
  rdfs:label "Event Id" ;
  :sensitivityTier :Internal .

ind:event_timestamp
  a owl:DatatypeProperty ;
  rdfs:domain ind:TrackingEvent ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Event Timestamp" ;
  :sensitivityTier :Internal .

ind:event_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:TrackingEvent ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Pickup" "Arrival" "Departure" "DeliveryAttempt" "Delivered" "Exception" "Return" ) ] ;
  rdfs:label "Event Type" ;
  :sensitivityTier :Internal .

ind:location_id
  a owl:ObjectProperty ;
  rdfs:domain ind:TrackingEvent ;
  rdfs:range ind:Facility ;
  rdfs:label "Location Id" ;
  :sensitivityTier :Internal .

ind:scan_location_description
  a owl:DatatypeProperty ;
  rdfs:domain ind:TrackingEvent ;
  rdfs:range xsd:string ;
  rdfs:label "Scan Location Description" ;
  :sensitivityTier :Internal .

ind:exception_code
  a owl:DatatypeProperty ;
  rdfs:domain ind:TrackingEvent ;
  rdfs:range xsd:string ;
  rdfs:label "Exception Code" ;
  :sensitivityTier :Internal .

ind:declaration_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:CustomsDeclaration ;
  rdfs:range xsd:string ;
  rdfs:label "Declaration Id" ;
  :sensitivityTier :Restricted .

ind:hs_code
  a owl:DatatypeProperty ;
  rdfs:domain ind:CustomsDeclaration ;
  rdfs:range xsd:string ;
  rdfs:label "Hs Code" ;
  rdfs:comment "Harmonized System commodity code" ;
  :sensitivityTier :Restricted .

ind:declared_value_usd
  a owl:DatatypeProperty ;
  rdfs:domain ind:CustomsDeclaration ;
  rdfs:range xsd:decimal ;
  rdfs:label "Declared Value Usd" ;
  :sensitivityTier :Restricted .

ind:country_of_origin
  a owl:DatatypeProperty ;
  rdfs:domain ind:CustomsDeclaration ;
  rdfs:range xsd:string ;
  rdfs:label "Country Of Origin" ;
  :sensitivityTier :Restricted .

ind:customs_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:CustomsDeclaration ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Pending" "Submitted" "Cleared" "Held" "Rejected" ) ] ;
  rdfs:label "Customs Status" ;
  :sensitivityTier :Restricted .

ind:duty_amount
  a owl:DatatypeProperty ;
  rdfs:domain ind:CustomsDeclaration ;
  rdfs:range xsd:decimal ;
  rdfs:label "Duty Amount" ;
  :sensitivityTier :Restricted .

ind:Carrier
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:carrier_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Carrier
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:carrier_name ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:CustomsDeclaration
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:country_of_origin ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:CustomsDeclaration
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:declaration_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:CustomsDeclaration
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:declared_value_usd ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:CustomsDeclaration
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:hs_code ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:CustomsDeclaration
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:shipment_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

