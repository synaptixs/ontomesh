ind:Order
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:currency ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Order
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:customer_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Order
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:order_date ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Order
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:order_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Order
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:total_value ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

