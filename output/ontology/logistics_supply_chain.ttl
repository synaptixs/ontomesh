ind:DeliveryException
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Delivery Exception" ;
  rdfs:comment "A delivery attempt failed or a shipment encountered a problem." ;
  :sensitivityTier :Internal .

ind:InventoryAlert
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Inventory Alert" ;
  rdfs:comment "Stock falls below reorder point or expiry date is approaching." ;
  :sensitivityTier :Internal .

ind:CarrierDelayEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Carrier Delay Event" ;
  rdfs:comment "Carrier reports delay — weather, mechanical, customs, or capacity." ;
  :sensitivityTier :Internal .

ind:TemperatureBreachEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Temperature Breach Event" ;
  rdfs:comment "Cold chain temperature breached acceptable range — product may be compromised." ;
  :sensitivityTier :Confidential .

<https://ontology.example.com/logistics/>
  rdfs:comment "Relationship (unformalised): A Shipment contains one or more Packages." ;
  rdfs:comment "Relationship (unformalised): A Shipment is transported by exactly one Carrier." ;
  rdfs:comment "Relationship (unformalised): A Shipment moves between exactly two Facilities (origin and destination)." ;
  rdfs:comment "Relationship (unformalised): An Order generates one or more Shipments." ;
  rdfs:comment "Relationship (unformalised): A TrackingEvent records the current state of a Shipment." ;
  rdfs:comment "Relationship (unformalised): An InventoryItem is held at exactly one Facility." ;
  rdfs:comment "Relationship (unformalised): A CustomsDeclaration covers exactly one Shipment."  .
