<https://ontology.example.com/logistics/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/logistics/1.0.0> ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Logistics & Supply Chain Ontology Module" ;
  rdfs:comment "Domain template for freight, warehousing, last-mile delivery, and supply chain visibility. Suitable for 3PL providers, e-commerce fulfillment, cold chain, and customs/trade compliance." ;
  dcterms:created "2026-04-22T18:31:07Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit Phase 3 — auto-generated from template" .


:Shipment
  a owl:Class ;
  rdfs:label "Shipment" ;
  rdfs:comment "A collection of goods being transported from origin to destination." ;
  owl:equivalentClass <schema:ParcelDelivery> ;
  :sensitivityTier :Internal .

:shipment_id
  a owl:DatatypeProperty ;
  rdfs:domain :Shipment ;
  rdfs:range xsd:string ;
  rdfs:label "Shipment Id" ;
  :sensitivityTier :Internal .

:tracking_number
  a owl:DatatypeProperty ;
  rdfs:domain :Shipment ;
