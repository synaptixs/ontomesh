  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:address ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Facility
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:country_code ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Facility
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:facility_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Facility
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:facility_name ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:InventoryItem
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:facility_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:InventoryItem
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:inventory_id ;
