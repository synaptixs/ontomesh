@prefix :       <https://ontology.example.com/enterprise/> .
@prefix sid:    <https://ontology.example.com/tmf/> .
@prefix dolce:  <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix sosa:   <http://www.w3.org/ns/sosa/> .
@prefix ssn:    <http://www.w3.org/ns/ssn/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix tmf:    <https://www.tmforum.org/sid/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dcterms:<http://purl.org/dc/terms/> .

<https://ontology.example.com/tmf/alignment/>
  a owl:Ontology ;
  rdfs:label "Ontology Alignment Module" ;
  rdfs:comment "Alignment axioms linking the generated ontology to DOLCE, FOAF, Schema.org, and SOSA." ;
  owl:imports <https://ontology.example.com/tmf/> ;
  dcterms:created "2026-07-26T18:03:56Z"^^xsd:dateTime ;
  dcterms:description "Phase 2B: owl:equivalentClass and skos:exactMatch axioms for cross-ontology alignment." .

# ═══════════════════════════════════════════════════════
# CLASS ALIGNMENTS
# ═══════════════════════════════════════════════════════

# ── DOLCE Class Alignments ───────────────────────────────────────────
sid:TmfEntity
  owl:equivalentClass <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#particular> ;
  rdfs:comment "DOLCE:particular — all SID entities are spatio-temporal particulars." .

:Party
  skos:closeMatch <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#agentive-physical-object> ;
  rdfs:comment "DOLCE:agentive-physical-object — a party is an agentive endurant that can act." .

:Resource
  skos:closeMatch <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#non-agentive-physical-object> ;
  rdfs:comment "DOLCE:non-agentive-physical-object — network resources are physical endurants without agency." .

:Service
  skos:closeMatch <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#process> ;
  rdfs:comment "DOLCE:process — a service is an ongoing process delivered over time." .

:DomainEvent
  owl:equivalentClass <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#event> ;
  rdfs:comment "DOLCE:event — domain events are perdurants / occurrents in DOLCE." .

:Agreement
  skos:closeMatch <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#social-object> ;
  rdfs:comment "DOLCE:social-object — agreements are social non-physical objects." .

:Policy
  skos:closeMatch <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#social-object> ;
  rdfs:comment "DOLCE:social-object — policies are normative social objects." .

# ── FOAF Class Alignments ────────────────────────────────────────────
:Party
  owl:equivalentClass <http://xmlns.com/foaf/0.1/Agent> ;
  rdfs:comment "foaf:Agent — a Party (individual or organization) is an agent." .

sid:Individual
  owl:equivalentClass <http://xmlns.com/foaf/0.1/Person> ;
  rdfs:comment "foaf:Person — an Individual is a natural person." .

:Organization
  owl:equivalentClass <http://xmlns.com/foaf/0.1/Organization> ;
  rdfs:comment "foaf:Organization — an Organization maps directly to foaf:Organization." .

:GeographicSite
  skos:closeMatch <http://xmlns.com/foaf/0.1/based_near> ;
  rdfs:comment "foaf:based_near — geographic sites provide location context for agents." .

# ── Schema.org Class Alignments ──────────────────────────────────────
:Party
  skos:closeMatch <https://schema.org/Person> ;
  rdfs:comment "schema:Person — for individual parties; schema:Organization for organizations." .

:Organization
  owl:equivalentClass <https://schema.org/Organization> ;
  rdfs:comment "schema:Organization — direct equivalence for legal/operational entities." .

sid:Individual
  owl:equivalentClass <https://schema.org/Person> ;
  rdfs:comment "schema:Person — direct equivalence for natural persons." .

:Product
  owl:equivalentClass <https://schema.org/Product> ;
  rdfs:comment "schema:Product — TMF SID product maps to schema:Product lifecycle." .

:ProductOffering
  skos:closeMatch <https://schema.org/Offer> ;
  rdfs:comment "schema:Offer — a ProductOffering is a commercial offer in the catalog." .

:GeographicSite
  owl:equivalentClass <https://schema.org/Place> ;
  rdfs:comment "schema:Place — geographic sites map to schema:Place." .

sid:GeographicPlace
  owl:equivalentClass <https://schema.org/PostalAddress> ;
  rdfs:comment "schema:PostalAddress — geographic addresses map to PostalAddress." .

:Agreement
  skos:closeMatch <https://schema.org/Service> ;
  rdfs:comment "schema:Service — agreements (SLA/commercial) govern service delivery." .

:CustomerBill
  skos:closeMatch <https://schema.org/Invoice> ;
  rdfs:comment "schema:Invoice — customer bills map closely to schema:Invoice." .

:ServiceOrder
  skos:closeMatch <https://schema.org/Order> ;
  rdfs:comment "schema:Order — service/product orders map to schema:Order." .

:ProductOrder
  owl:equivalentClass <https://schema.org/Order> ;
  rdfs:comment "schema:Order — product orders are customer purchase orders." .

:TroubleTicket
  skos:closeMatch <https://schema.org/Question> ;
  rdfs:comment "schema:Question — trouble tickets are support requests requiring resolution." .

# ── SOSA/SSN Class Alignments ────────────────────────────────────────
:ObservationRecord
  owl:equivalentClass <http://www.w3.org/ns/sosa/Observation> ;
  rdfs:comment "sosa:Observation — an ObservationRecord is a SOSA observation with provenance." .

:PerformanceIndicator
  owl:equivalentClass <http://www.w3.org/ns/sosa/Observation> ;
  rdfs:comment "sosa:Observation — KPI measurements are sensor observations with result values." .

:Resource
  skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
  rdfs:comment "sosa:FeatureOfInterest — resources are the features that observations are about." .

sid:NetworkFunction
  skos:closeMatch <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
  rdfs:comment "sosa:FeatureOfInterest — NFs are monitored features of interest." .

:Agent
  skos:closeMatch <http://www.w3.org/ns/sosa/Sensor> ;
  rdfs:comment "sosa:Sensor — monitoring agents (ML Agent, NOC system) act as sensors." .

:ServiceQualityReport
  skos:closeMatch <http://www.w3.org/ns/sosa/Result> ;
  rdfs:comment "sosa:Result — quality reports aggregate sensor observation results." .

:DriftObservation
  owl:equivalentClass <http://www.w3.org/ns/sosa/Observation> ;
  rdfs:comment "sosa:Observation — ML drift observations are specialized SOSA observations." .

:NetworkSliceProfile
  skos:closeMatch <http://www.w3.org/ns/ssn/System> ;
  rdfs:comment "ssn:System — a network slice profile describes a sensing/acting system." .

# ═══════════════════════════════════════════════════════
# PROPERTY ALIGNMENTS
# ═══════════════════════════════════════════════════════

:hasName
  owl:equivalentProperty <http://xmlns.com/foaf/0.1/name> ;
  rdfs:comment "foaf:name — entity names map to foaf:name." .

:hasEmail
  owl:equivalentProperty <http://xmlns.com/foaf/0.1/mbox> ;
  rdfs:comment "foaf:mbox — email properties map to foaf:mbox." .

:hasName
  skos:closeMatch <https://schema.org/name> ;
  rdfs:comment "schema:name — entity name maps to schema:name." .

:hasDescription
  owl:equivalentProperty <https://schema.org/description> ;
  rdfs:comment "schema:description — description maps directly." .

:hasStartDate
  owl:equivalentProperty <https://schema.org/startDate> ;
  rdfs:comment "schema:startDate — start dates align with schema:startDate." .

:hasEndDate
  owl:equivalentProperty <https://schema.org/endDate> ;
  rdfs:comment "schema:endDate — end dates align with schema:endDate." .

:hasAmountDue
  skos:closeMatch <https://schema.org/totalPaymentDue> ;
  rdfs:comment "schema:totalPaymentDue — bill amount due maps to schema:totalPaymentDue." .

:hasConfidenceScore
  skos:closeMatch <http://www.w3.org/ns/sosa/resultQuality> ;
  rdfs:comment "sosa:resultQuality — confidence score maps to observation result quality." .

:hasObservedAt
  owl:equivalentProperty <http://www.w3.org/ns/sosa/resultTime> ;
  rdfs:comment "sosa:resultTime — observation timestamp maps to resultTime." .

:derivationMethod
  skos:closeMatch <http://www.w3.org/ns/prov#wasGeneratedBy> ;
  rdfs:comment "prov:wasGeneratedBy — derivation method relates to provenance generation." .

:hasSourceRef
  owl:equivalentProperty <http://www.w3.org/ns/prov#hadPrimarySource> ;
  rdfs:comment "prov:hadPrimarySource — sourceRef maps to PROV-O primary source." .

:recordedBy
  owl:equivalentProperty <http://www.w3.org/ns/sosa/madeBySensor> ;
  rdfs:comment "sosa:madeBySensor — the agent making the observation is the sensor." .

:refersToResource
  owl:equivalentProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
  rdfs:comment "sosa:hasFeatureOfInterest — the resource being observed." .

