@prefix :     <https://ontology.example.com/enterprise/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <https://ontology.example.com/shapes/enterprise/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://ontology.example.com/enterprise/events/>
  a owl:Ontology ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Enterprise Event Subclass Hierarchy" .

# ── Event Subclass Hierarchy ────────────────────────────────────────

:ComplianceAuditEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      :DomainEvent
      [ a owl:Restriction ;
        owl:onProperty :hasEventType ;
        owl:hasValue "COMPLIANCE_AUDIT" ]
    )
  ] ;
  rdfs:label "Compliance Audit Event" ;
  rdfs:comment "Events of DomainEvent whose event_type is COMPLIANCE_AUDIT." ;
  :sensitivityTier :Internal .

:IncidentEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      :DomainEvent
      [ a owl:Restriction ;
        owl:onProperty :hasEventType ;
        owl:hasValue "INCIDENT" ]
    )
  ] ;
  rdfs:label "Incident Event" ;
  rdfs:comment "Events of DomainEvent whose event_type is INCIDENT." ;
  :sensitivityTier :Internal .

:InspectionEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      :DomainEvent
      [ a owl:Restriction ;
        owl:onProperty :hasEventType ;
        owl:hasValue "INSPECTION" ]
    )
  ] ;
  rdfs:label "Inspection Event" ;
  rdfs:comment "Events of DomainEvent whose event_type is INSPECTION." ;
  :sensitivityTier :Internal .

:MaintenanceEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
      :DomainEvent
      [ a owl:Restriction ;
        owl:onProperty :hasEventType ;
        owl:hasValue "MAINTENANCE" ]
    )
  ] ;
  rdfs:label "Maintenance Event" ;
  rdfs:comment "Events of DomainEvent whose event_type is MAINTENANCE." ;
  :sensitivityTier :Internal .

# Sibling event subclasses were detected but no owl:AllDisjointClasses
# axiom is emitted: event_type values are frequently lifecycle
# phases of one entity rather than mutually exclusive kinds, and
# asserting disjointness over them makes any entity that passes
# through two phases unsatisfiable. Declare disjointness explicitly
# in metadata when it genuinely holds.

#   candidate group: :ComplianceAuditEvent :IncidentEvent :InspectionEvent :MaintenanceEvent
