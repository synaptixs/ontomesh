  :sensitivityTier :Internal ;
  skos:prefLabel "Runtime Payload" ;
  skos:altLabel "LLM Payload" ;
  skos:altLabel "AI Payload" ;
  rdfs:isDefinedBy "CQ-RT-03"  .

:Agreement
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
