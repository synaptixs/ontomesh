# ── Data Properties ─────────────────────────────────────────────────

:hasValidFrom
  a owl:DatatypeProperty ;
  rdfs:label "Valid From" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :AgentRoles :Agreement :FederationPartners :PartyRole ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasValidUntil
  a owl:DatatypeProperty ;
  rdfs:label "Valid Until" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :AgentRoles :Agreement :FederationPartners :PartyRole ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasAgentIri
  a owl:DatatypeProperty ;
  rdfs:label "Agent IRI" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:anyURI ;
  rdfs:comment "Persistent IRI for use in PROV-O provenance graphs." ;
  :sensitivityTier :Internal .

:hasName
  a owl:DatatypeProperty ;
  rdfs:label "Name" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :Agent :Agreement :Asset :Attachment :Characteristic :CustomerAccount :GeographicLocation :GeographicSite :NetworkSliceProfile :Organization :Party :PerformanceIndicator :Policy :Product :ProductOffering :ProductSpecification :Resource :ResourceSpecification :RuntimeFlavor :Service :ServiceSpecification :UserRole ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasAgentType
  a owl:DatatypeProperty ;
  rdfs:label "Agent Type" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasCredentialExpiry
  a owl:DatatypeProperty ;
  rdfs:label "Credential Expiry" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:dateTime ;
  rdfs:comment "Expiry timestamp for AI agent credentials." ;
  :sensitivityTier :Confidential .

:hasAuthorizedTiers
  a owl:DatatypeProperty ;
  rdfs:label "Authorized Tiers" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasActive
  a owl:DatatypeProperty ;
  rdfs:label "Active" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :Agent :Organization :Policy ) ] ;
  rdfs:range xsd:boolean ;
  :sensitivityTier :Internal .

:hasCreatedAt
  a owl:DatatypeProperty ;
  rdfs:label "Created At" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :Agent :Agreement :Alarm :Asset :AssetType :Attachment :Characteristic :ConflictEvent :CustomerAccount :CustomerBill :DomainEvent :EmbeddingIndexes :EventSubscription :FederationTrustLedger :GeographicLocation :GeographicSite :NetworkSliceProfile :ObservationRecord :OntologyEvolutionProposals :OntologyVersionLedger :Organization :Party :PartyRole :PerformanceIndicator :Policy :Product :ProductOffering :ProductOfferingQualification :ProductOrder :ProductSpecification :Resource :ResourceRelationship :ResourceSpecification :RuntimeFlavor :RuntimeGrounding :RuntimePayload :Service :ServiceOrder :ServiceProblem :ServiceQualityReport :ServiceSpecification :TroubleTicket :UserRole ) ] ;
  rdfs:range xsd:dateTime ;
  :sensitivityTier :Internal .

:hasCode
  a owl:DatatypeProperty ;
  rdfs:label "Code" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :AssetType :Policy :Role ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasLabel
  a owl:DatatypeProperty ;
  rdfs:label "Label" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :AssetType :Role ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasDescription
  a owl:DatatypeProperty ;
  rdfs:label "Description" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :Agreement :AssetType :Attachment :ConflictEvent :DomainEvent :GeographicSite :PerformanceIndicator :Policy :ProductOffering :ProductOfferingQualification :ProductSpecification :ResourceSpecification :Role :RuntimeFlavor :ServiceProblem :ServiceQualityReport :ServiceSpecification :TroubleTicket :UserRole ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasUnitOfMeasure
  a owl:DatatypeProperty ;
  rdfs:label "Unit Of Measure" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :AssetType :ObservationRecord :PerformanceIndicator ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasExternalId
  a owl:DatatypeProperty ;
  rdfs:label "External Identifier" ;
  rdfs:domain :Asset ;
  rdfs:range xsd:string ;
  rdfs:comment "Identifier used in external systems (e.g. OSS/BSS, NMS)." ;
  :sensitivityTier :Internal .

:hasLocationCode
  a owl:DatatypeProperty ;
  rdfs:label "Location Code" ;
  rdfs:domain :Asset ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasStatus
