  rdfs:label "Title" ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :DomainEvent :OntologyEvolutionProposals :Policy ) ] ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasOutcome
  a owl:DatatypeProperty ;
