:Attachment
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Attachment" ;
  rdfs:comment "A file or URL attachment linked to any TMF entity per SID Common ABE." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Attachment"  .

:Characteristic
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Characteristic" ;
  rdfs:comment "A key-value attribute pair that extends any entity per SID Characteristic ABE." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Characteristic" ;
  skos:altLabel "Attribute" ;
  skos:altLabel "Property" ;
  skos:altLabel "Feature" ;
