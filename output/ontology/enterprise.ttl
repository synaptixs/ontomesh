                    owl:onProperty :hasName ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasSensitivityTier ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasOwlClasses ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasDbTables ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ]  .

