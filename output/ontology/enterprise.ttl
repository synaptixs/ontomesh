@prefix :     <https://ontology.example.com/enterprise/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <https://ontology.example.com/shapes/enterprise/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://ontology.example.com/enterprise/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/enterprise/1.0.0> ;
  owl:versionInfo "1.0.0" ;
  rdfs:label "Enterprise Domain Ontology" ;
  rdfs:comment "Auto-generated from relational schema + ontology_metadata. Covers all operational domain entities, events, agents, policies, observations, and provenance patterns." ;
  dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
  dcterms:created "2026-07-26T18:03:53Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit — Auto-generated from DB schema" .


# ── Sensitivity Annotation Property ──────────────────────────────────
:sensitivityTier
  a owl:AnnotationProperty ;
  rdfs:label "Sensitivity Tier" ;
  rdfs:comment "Required on all classes and data properties. Values: Public, Internal, Confidential, Restricted." .

:SensitivityTierValue a owl:Class ;
  rdfs:label "Sensitivity Tier Value" .

:Public       a :SensitivityTierValue ; rdfs:label "Public" .
:Internal     a :SensitivityTierValue ; rdfs:label "Internal" .
:Confidential a :SensitivityTierValue ; rdfs:label "Confidential" .
:Restricted   a :SensitivityTierValue ; rdfs:label "Restricted" .


# ── Base Classes ──────────────────────────────────────────────────────
:DomainEntity
  a owl:Class ;
  rdfs:label "Domain Entity" ;
  rdfs:comment "Root class for all domain entities." ;
  :sensitivityTier :Internal .

:DomainEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Domain Event" ;
  rdfs:comment "A significant occurrence that changes domain state or produces evidence." ;
  :sensitivityTier :Internal .

:ObservationRecord
  a owl:Class ;
  rdfs:subClassOf :DomainEntity, prov:Entity ;
  rdfs:label "Observation Record" ;
  rdfs:comment "A measured, inferred, or imported fact with full PROV-O provenance." ;
  :sensitivityTier :Confidential .


# ── Domain Classes ──────────────────────────────────────────────────

:AgentRoles
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Agent Roles" ;
  :sensitivityTier :Internal  .

:Agent
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Agent" ;
  rdfs:comment "A human, system, AI agent, or sensor that produces or acts on domain facts." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Agent" ;
  skos:altLabel "Actor" ;
  skos:altLabel "System Agent" ;
  skos:altLabel "Sensor" ;
  rdfs:isDefinedBy "CQ-004, CQ-005" ;
  owl:hasKey ( :hasAgentIri ) ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasName ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasAgentType ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ]  .

:AssetType
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Asset Type" ;
  rdfs:comment "A classification category for managed assets." ;
  :sensitivityTier :Public ;
  skos:prefLabel "Asset Type" ;
  skos:altLabel "Asset Category" ;
  skos:altLabel "Resource Class" ;
  rdfs:isDefinedBy "CQ-002" ;
  owl:hasKey ( :hasCode ) ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasCode ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasLabel ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ]  .

:Asset
