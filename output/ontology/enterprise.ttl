@prefix :     <https://ontology.example.com/enterprise/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <https://ontology.example.com/shapes/enterprise/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://ontology.example.com/enterprise/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/enterprise/1.0.0> ;
  owl:versionInfo "1.0.0" ;
  rdfs:label "Enterprise Domain Ontology" ;
  rdfs:comment "Auto-generated from relational schema + ontology_metadata. Covers all operational domain entities, events, agents, policies, observations, and provenance patterns." ;
  dcterms:created "2026-04-21T02:57:44Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit — Auto-generated from DB schema" .


# ── Sensitivity Annotation Property ──────────────────────────────────
:sensitivityTier
  a owl:AnnotationProperty ;
  rdfs:label "Sensitivity Tier" ;
  rdfs:comment "Required on all classes and data properties. Values: Public, Internal, Confidential, Restricted." .

:SensitivityTierValue a owl:Class ;
  rdfs:label "Sensitivity Tier Value" .

:Public       a :SensitivityTierValue ; rdfs:label "Public" .
:Internal     a :SensitivityTierValue ; rdfs:label "Internal" .
:Confidential a :SensitivityTierValue ; rdfs:label "Confidential" .
:Restricted   a :SensitivityTierValue ; rdfs:label "Restricted" .


# ── Base Classes ──────────────────────────────────────────────────────
:DomainEntity
  a owl:Class ;
  rdfs:label "Domain Entity" ;
  rdfs:comment "Root class for all domain entities." ;
  :sensitivityTier :Internal .

:DomainEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Domain Event" ;
  rdfs:comment "A significant occurrence that changes domain state or produces evidence." ;
  :sensitivityTier :Internal .

:ObservationRecord
  a owl:Class ;
  rdfs:subClassOf :DomainEntity, prov:Entity ;
  rdfs:label "Observation Record" ;
  rdfs:comment "A measured, inferred, or imported fact with full PROV-O provenance." ;
  :sensitivityTier :Confidential .


# ── Domain Classes ──────────────────────────────────────────────────

:AgentRoles
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Agent Roles" ;
  :sensitivityTier :Internal  .

:Agent
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Agent" ;
  rdfs:comment "A human, system, AI agent, or sensor that produces or acts on domain facts." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Agent" ;
  skos:altLabel "Actor" ;
  skos:altLabel "System Agent" ;
  skos:altLabel "Sensor" ;
  rdfs:isDefinedBy "CQ-004, CQ-005"  .

:AssetType
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Asset Type" ;
  rdfs:comment "A classification category for managed assets." ;
  :sensitivityTier :Public ;
  skos:prefLabel "Asset Type" ;
  skos:altLabel "Asset Category" ;
  skos:altLabel "Resource Class" ;
  rdfs:isDefinedBy "CQ-002"  .

:Asset
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Asset" ;
  rdfs:comment "A physical or logical resource managed by the organization." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Asset" ;
  skos:altLabel "Resource" ;
  skos:altLabel "Managed Object" ;
  skos:altLabel "Network Element" ;
  rdfs:isDefinedBy "CQ-001, CQ-002, CQ-003, CQ-007"  .

:DomainEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Domain Event" ;
  rdfs:comment "A significant occurrence in the domain that changes state or produces evidence." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Domain Event" ;
  skos:altLabel "Operation" ;
  skos:altLabel "Activity" ;
  skos:altLabel "Incident" ;
  skos:altLabel "Inspection" ;
  rdfs:isDefinedBy "CQ-003, CQ-004, CQ-005, CQ-007"  .

:EventParticipants
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Event Participants" ;
  :sensitivityTier :Internal  .

:ObservationRecord
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Observation" ;
  rdfs:comment "A measured, computed, or imported fact about an asset or event, with provenance." ;
  :sensitivityTier :Confidential ;
  skos:prefLabel "Observation" ;
  skos:altLabel "Measurement" ;
  skos:altLabel "Reading" ;
  skos:altLabel "Detection" ;
  skos:altLabel "Finding" ;
  rdfs:isDefinedBy "CQ-004, CQ-005, CQ-008"  .

:Organization
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Organization" ;
  rdfs:comment "A legal or operational entity that owns, operates, or governs assets." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Organization" ;
  skos:altLabel "Enterprise" ;
  skos:altLabel "Company" ;
  skos:altLabel "Entity" ;
  rdfs:isDefinedBy "CQ-001, CQ-006"  .

:Policy
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Policy" ;
  rdfs:comment "A rule or constraint that governs asset operations and agent behaviour." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Policy" ;
  skos:altLabel "Rule" ;
  skos:altLabel "Standard" ;
  skos:altLabel "SLA" ;
  rdfs:isDefinedBy "CQ-007"  .

:PolicyApplication
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Policy Application" ;
  rdfs:comment "Records the application of a policy to an event or asset with outcome." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Policy Application" ;
  skos:altLabel "Compliance Check" ;
  skos:altLabel "Audit Record" ;
  rdfs:isDefinedBy "CQ-007"  .

:Role
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Role" ;
  rdfs:comment "A contextual function an agent performs in a specific scope." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Role" ;
  skos:altLabel "Function" ;
  skos:altLabel "Responsibility" ;
  rdfs:isDefinedBy "CQ-006"  .

:RuntimeFlavor
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Runtime Flavor" ;
  rdfs:comment "An ontology domain flavor configuration defining scope, OWL classes, SHACL shapes, and sensitivity tier for AI runtime sessions." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Runtime Flavor" ;
  skos:altLabel "Ontology Flavor" ;
  skos:altLabel "Domain Flavor" ;
  skos:altLabel "LLM Scope" ;
  rdfs:isDefinedBy "CQ-RT-01"  .

:RuntimeGrounding
  a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
