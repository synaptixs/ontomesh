  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Asset" ;
  rdfs:comment "A physical or logical resource managed by the organization." ;
  :sensitivityTier :Internal ;
  skos:prefLabel "Asset" ;
  skos:altLabel "Resource" ;
  skos:altLabel "Managed Object" ;
  skos:altLabel "Network Element" ;
  rdfs:isDefinedBy "CQ-001, CQ-002, CQ-003, CQ-007" ;
  owl:hasKey ( :hasExternalId ) ;
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty :hasName ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ]  .

:ComplianceBundles
