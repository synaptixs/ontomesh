  rdfs:domain [ a owl:Class ;
                owl:unionOf ( :Agreement :Asset :ConflictEvent :CustomerAccount :DomainEvent :EventSubscription :FederationQueryLog :OntologyEvolutionProposals :PartyRole :Policy :Product :ServiceProblem :ServiceQualityReport :TroubleTicket ) ] ;
  rdfs:range xsd:string ;
