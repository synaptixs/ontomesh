# ── Data Properties ─────────────────────────────────────────────────

:hasValidFrom
  a owl:DatatypeProperty ;
  rdfs:label "Valid From" ;
  rdfs:domain :AgentRoles ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasValidUntil
  a owl:DatatypeProperty ;
  rdfs:label "Valid Until" ;
  rdfs:domain :AgentRoles ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasAgentIri
  a owl:DatatypeProperty ;
  rdfs:label "Agent IRI" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:anyURI ;
  rdfs:comment "Persistent IRI for use in PROV-O provenance graphs." ;
  :sensitivityTier :Internal .

:hasName
  a owl:DatatypeProperty ;
  rdfs:label "Name" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:string ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger ;
  :sensitivityTier :Internal .

:hasAgentType
  a owl:DatatypeProperty ;
  rdfs:label "Agent Type" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:string ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger ;
  :sensitivityTier :Internal .

:hasCredentialExpiry
  a owl:DatatypeProperty ;
  rdfs:label "Credential Expiry" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:dateTime ;
  rdfs:comment "Expiry timestamp for AI agent credentials." ;
  :sensitivityTier :Confidential .

:hasAuthorizedTiers
  a owl:DatatypeProperty ;
  rdfs:label "Authorized Tiers" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:string ;
  :sensitivityTier :Internal .

:hasActive
  a owl:DatatypeProperty ;
  rdfs:label "Active" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:boolean ;
  :sensitivityTier :Internal .

:hasCreatedAt
  a owl:DatatypeProperty ;
  rdfs:label "Created At" ;
  rdfs:domain :Agent ;
  rdfs:range xsd:dateTime ;
  :sensitivityTier :Internal .

:hasCode
  a owl:DatatypeProperty ;
  rdfs:label "Code" ;
  rdfs:domain :AssetType ;
  rdfs:range xsd:string ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger ;
  :sensitivityTier :Internal .

:hasLabel
  a owl:DatatypeProperty ;
  rdfs:label "Label" ;
  rdfs:domain :AssetType ;
  rdfs:range xsd:string ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger ;
  :sensitivityTier :Internal .

:hasDescription
  a owl:DatatypeProperty ;
