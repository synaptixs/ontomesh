  :sensitivityTier :Public .

:atc_code
  a owl:DatatypeProperty ;
  rdfs:domain :MedicinalProduct ;
  rdfs:range xsd:string ;
  rdfs:label "Atc Code" ;
  rdfs:comment "WHO ATC classification code" ;
  :sensitivityTier :Public .

:regulatory_status
  a owl:DatatypeProperty ;
  rdfs:domain :MedicinalProduct ;
  rdfs:range xsd:string ;
  rdfs:label "Regulatory Status" ;
  :sensitivityTier :Public .

:marketing_authorisation_number
  a owl:DatatypeProperty ;
