  :sensitivityTier :Public .

:orphan_designation
  a owl:DatatypeProperty ;
  rdfs:domain :MedicinalProduct ;
  rdfs:range xsd:boolean ;
  rdfs:label "Orphan Designation" ;
  :sensitivityTier :Public .

