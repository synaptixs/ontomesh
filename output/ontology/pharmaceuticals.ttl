@prefix :      <https://ontology.example.com/enterprise/> .
@prefix ind:   <https://ontology.example.com/pharma/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://ontology.example.com/pharma/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/pharma/1.0.0> ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Pharmaceuticals Ontology Module" ;
  rdfs:comment "Domain template for pharmaceutical manufacturers, CROs, and regulatory affairs teams. Covers drug product lifecycle from R&D through clinical trials, manufacturing, and pharmacovigilance. Aligned with IDMP (Identification of Medicinal Products, ISO 11616/11238/11239/11240/11615), EMA SPOR, ICH E2B(R3), and HL7 FHIR R4 MedicinalProduct resources." ;
  dcterms:created "2026-07-26T16:58:56Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit Phase 3 — auto-generated from template" .


ind:MedicinalProduct
  a owl:Class ;
  rdfs:label "Medicinal Product" ;
  rdfs:comment "A regulated pharmaceutical product with a marketing authorisation." ;
  owl:equivalentClass <http://hl7.org/fhir/MedicinalProduct> ;
  owl:equivalentClass <https://spor.ema.europa.eu/v1/lists/MedicinalProduct> ;
  :sensitivityTier :Public .

ind:ActiveSubstance
  a owl:Class ;
  rdfs:label "Active Substance" ;
  rdfs:comment "A chemical or biological substance with pharmacological activity." ;
  owl:equivalentClass <https://spor.ema.europa.eu/v1/lists/Substance> ;
  :sensitivityTier :Public .

ind:ClinicalTrial
  a owl:Class ;
  rdfs:label "Clinical Trial" ;
  rdfs:comment "A human study evaluating the safety and efficacy of a medicinal product." ;
  :sensitivityTier :Internal .

ind:ManufacturingSite
  a owl:Class ;
  rdfs:label "Manufacturing Site" ;
  rdfs:comment "A GMP-certified facility where pharmaceutical products are manufactured." ;
  :sensitivityTier :Internal .

ind:Batch
  a owl:Class ;
  rdfs:label "Product Batch" ;
  rdfs:comment "A manufactured lot of a medicinal product with traceability to raw materials." ;
  :sensitivityTier :Internal .

ind:AdverseEvent
  a owl:Class ;
  rdfs:label "Adverse Event" ;
  rdfs:comment "An undesirable medical occurrence in a patient administered a medicinal product." ;
  owl:equivalentClass <http://hl7.org/fhir/AdverseEvent> ;
  :sensitivityTier :Confidential .

ind:RegulatorySubmission
  a owl:Class ;
  rdfs:label "Regulatory Submission" ;
  rdfs:comment "A dossier or safety report submitted to a health authority (EMA, FDA, PMDA)." ;
  :sensitivityTier :Restricted .

ind:QualityNonConformance
  a owl:Class ;
  rdfs:label "Quality Non-Conformance" ;
  rdfs:comment "A deviation, out-of-specification result, or quality complaint." ;
  :sensitivityTier :Confidential .

ind:product_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:AdverseEvent ind:Batch ind:ClinicalTrial ind:MedicinalProduct ind:QualityNonConformance ind:RegulatorySubmission ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Product Id" ;
  :sensitivityTier :Restricted .

ind:product_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:MedicinalProduct ;
  rdfs:range xsd:string ;
  rdfs:label "Product Name" ;
  :sensitivityTier :Public .

ind:inn
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:ActiveSubstance ind:MedicinalProduct ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Inn" ;
  rdfs:comment "WHO International Nonproprietary Name" ;
  :sensitivityTier :Public .

ind:atc_code
  a owl:DatatypeProperty ;
  rdfs:domain ind:MedicinalProduct ;
  rdfs:range xsd:string ;
  rdfs:label "Atc Code" ;
  rdfs:comment "WHO ATC classification code" ;
  :sensitivityTier :Public .

ind:regulatory_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:MedicinalProduct ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "PreClinical" "Phase1" "Phase2" "Phase3" "MAA_Submitted" "Approved" "Withdrawn" "Discontinued" ) ] ;
  rdfs:label "Regulatory Status" ;
  :sensitivityTier :Public .

ind:marketing_authorisation_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:MedicinalProduct ;
  rdfs:range xsd:string ;
  rdfs:label "Marketing Authorisation Number" ;
  :sensitivityTier :Public .

ind:indication
  a owl:DatatypeProperty ;
  rdfs:domain ind:MedicinalProduct ;
  rdfs:range xsd:string ;
  rdfs:label "Indication" ;
  :sensitivityTier :Public .

ind:therapeutic_area
  a owl:DatatypeProperty ;
  rdfs:domain ind:MedicinalProduct ;
  rdfs:range xsd:string ;
  rdfs:label "Therapeutic Area" ;
  :sensitivityTier :Public .

ind:orphan_designation
  a owl:DatatypeProperty ;
  rdfs:domain ind:MedicinalProduct ;
  rdfs:range xsd:boolean ;
  rdfs:label "Orphan Designation" ;
  :sensitivityTier :Public .

ind:substance_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:ActiveSubstance ;
  rdfs:range xsd:string ;
  rdfs:label "Substance Id" ;
  :sensitivityTier :Public .

ind:substance_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:ActiveSubstance ;
  rdfs:range xsd:string ;
  rdfs:label "Substance Name" ;
  :sensitivityTier :Public .

ind:cas_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:ActiveSubstance ;
  rdfs:range xsd:string ;
  rdfs:label "Cas Number" ;
  rdfs:comment "CAS Registry Number" ;
  :sensitivityTier :Public .

ind:chebi_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:ActiveSubstance ;
  rdfs:range xsd:string ;
  rdfs:label "Chebi Id" ;
  :sensitivityTier :Public .

ind:substance_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:ActiveSubstance ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "SmallMolecule" "Biologic" "Peptide" "Oligonucleotide" "CellGeneTherapy" "Radiopharmaceutical" ) ] ;
  rdfs:label "Substance Type" ;
  :sensitivityTier :Public .

ind:molecular_formula
  a owl:DatatypeProperty ;
  rdfs:domain ind:ActiveSubstance ;
  rdfs:range xsd:string ;
  rdfs:label "Molecular Formula" ;
  :sensitivityTier :Public .

ind:molecular_weight_dalton
  a owl:DatatypeProperty ;
  rdfs:domain ind:ActiveSubstance ;
  rdfs:range xsd:decimal ;
  rdfs:label "Molecular Weight Dalton" ;
  :sensitivityTier :Public .

ind:trial_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:string ;
  rdfs:label "Trial Id" ;
  :sensitivityTier :Internal .

ind:nct_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:string ;
  rdfs:label "Nct Number" ;
  rdfs:comment "ClinicalTrials.gov NCT identifier" ;
  :sensitivityTier :Internal .

ind:eudract_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:string ;
  rdfs:label "Eudract Number" ;
  rdfs:comment "EU Clinical Trials Register" ;
  :sensitivityTier :Internal .

ind:phase
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Phase1" "Phase1_2" "Phase2" "Phase2_3" "Phase3" "Phase4" "Observational" ) ] ;
  rdfs:label "Phase" ;
  :sensitivityTier :Internal .

ind:status
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:ClinicalTrial ind:RegulatorySubmission ) ] ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Planned" "Recruiting" "Active" "Completed" "Terminated" "Suspended" "Withdrawn" ) ] ;
  rdfs:label "Status" ;
  :sensitivityTier :Restricted .

ind:sponsor
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:string ;
  rdfs:label "Sponsor" ;
  :sensitivityTier :Internal .

ind:planned_enrolment
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:integer ;
  rdfs:label "Planned Enrolment" ;
  :sensitivityTier :Internal .

ind:actual_enrolment
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:integer ;
  rdfs:label "Actual Enrolment" ;
  :sensitivityTier :Internal .

ind:primary_endpoint
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:string ;
  rdfs:label "Primary Endpoint" ;
  :sensitivityTier :Internal .

ind:study_start_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:date ;
  rdfs:label "Study Start Date" ;
  :sensitivityTier :Internal .

ind:primary_completion_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:ClinicalTrial ;
  rdfs:range xsd:date ;
  rdfs:label "Primary Completion Date" ;
  :sensitivityTier :Internal .

ind:site_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Batch ind:ManufacturingSite ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Site Id" ;
  :sensitivityTier :Internal .

ind:site_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:ManufacturingSite ;
  rdfs:range xsd:string ;
  rdfs:label "Site Name" ;
  :sensitivityTier :Internal .

ind:address
  a owl:DatatypeProperty ;
  rdfs:domain ind:ManufacturingSite ;
  rdfs:range xsd:string ;
  rdfs:label "Address" ;
  :sensitivityTier :Internal .

ind:country_code
  a owl:DatatypeProperty ;
  rdfs:domain ind:ManufacturingSite ;
  rdfs:range xsd:string ;
  rdfs:label "Country Code" ;
  :sensitivityTier :Internal .

ind:gmp_certificate_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:ManufacturingSite ;
  rdfs:range xsd:string ;
  rdfs:label "Gmp Certificate Number" ;
  :sensitivityTier :Internal .

ind:gmp_certificate_expiry
  a owl:DatatypeProperty ;
  rdfs:domain ind:ManufacturingSite ;
  rdfs:range xsd:date ;
  rdfs:label "Gmp Certificate Expiry" ;
  :sensitivityTier :Internal .

ind:site_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:ManufacturingSite ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "API" "Formulation" "Packaging" "QualityControl" "Biologics" "Sterile" ) ] ;
  rdfs:label "Site Type" ;
  :sensitivityTier :Internal .

ind:capacity_batch_per_year
  a owl:DatatypeProperty ;
  rdfs:domain ind:ManufacturingSite ;
  rdfs:range xsd:integer ;
  rdfs:label "Capacity Batch Per Year" ;
  :sensitivityTier :Internal .

ind:batch_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:AdverseEvent ind:Batch ind:QualityNonConformance ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Batch Id" ;
  :sensitivityTier :Confidential .

ind:batch_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:Batch ;
  rdfs:range xsd:string ;
  rdfs:label "Batch Number" ;
  :sensitivityTier :Internal .

ind:manufacture_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Batch ;
  rdfs:range xsd:date ;
  rdfs:label "Manufacture Date" ;
  :sensitivityTier :Internal .

ind:expiry_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Batch ;
  rdfs:range xsd:date ;
  rdfs:label "Expiry Date" ;
  :sensitivityTier :Internal .

ind:batch_size_units
  a owl:DatatypeProperty ;
  rdfs:domain ind:Batch ;
  rdfs:range xsd:integer ;
  rdfs:label "Batch Size Units" ;
  :sensitivityTier :Internal .

ind:batch_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:Batch ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "InProcess" "Released" "Quarantined" "Rejected" "Recalled" "Distributed" ) ] ;
  rdfs:label "Batch Status" ;
  :sensitivityTier :Internal .

ind:quality_release_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Batch ;
  rdfs:range xsd:date ;
  rdfs:label "Quality Release Date" ;
  :sensitivityTier :Internal .

ind:ae_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range xsd:string ;
  rdfs:label "Ae Id" ;
  :sensitivityTier :Confidential .

ind:reporter_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "HealthcareProfessional" "Patient" "Regulator" "Literature" ) ] ;
  rdfs:label "Reporter Type" ;
  :sensitivityTier :Confidential .

ind:seriousness
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "NonSerious" "Serious" "Fatal" ) ] ;
  rdfs:label "Seriousness" ;
  :sensitivityTier :Confidential .

ind:meddra_preferred_term
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range xsd:string ;
  rdfs:label "Meddra Preferred Term" ;
  rdfs:comment "MedDRA PT code" ;
  :sensitivityTier :Confidential .

ind:onset_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range xsd:date ;
  rdfs:label "Onset Date" ;
  :sensitivityTier :Confidential .

ind:report_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Report Date" ;
  :sensitivityTier :Confidential .

ind:case_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range xsd:string ;
  rdfs:label "Case Number" ;
  :sensitivityTier :Confidential .

ind:regulatory_submission_due
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range xsd:date ;
  rdfs:label "Regulatory Submission Due" ;
  rdfs:comment "15-day for serious unexpected" ;
  :sensitivityTier :Confidential .

ind:regulatory_submitted
  a owl:DatatypeProperty ;
  rdfs:domain ind:AdverseEvent ;
  rdfs:range xsd:boolean ;
  rdfs:label "Regulatory Submitted" ;
  :sensitivityTier :Confidential .

ind:submission_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatorySubmission ;
  rdfs:range xsd:string ;
  rdfs:label "Submission Id" ;
  :sensitivityTier :Restricted .

ind:authority
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatorySubmission ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "EMA" "FDA" "PMDA" "HC" "TGA" "NMPA" "ANVISA" "CDSCO" ) ] ;
  rdfs:label "Authority" ;
  :sensitivityTier :Restricted .

ind:submission_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatorySubmission ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "MAA" "Variation" "Renewal" "ICSR" "PSUR" "PBRER" "DSUR" "IND" "NDA" "BLA" ) ] ;
  rdfs:label "Submission Type" ;
  :sensitivityTier :Restricted .

ind:submission_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatorySubmission ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Submission Date" ;
  :sensitivityTier :Restricted .

ind:deadline_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatorySubmission ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Deadline Date" ;
  :sensitivityTier :Restricted .

ind:ectd_sequence
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatorySubmission ;
  rdfs:range xsd:string ;
  rdfs:label "Ectd Sequence" ;
  rdfs:comment "eCTD submission sequence number" ;
  :sensitivityTier :Restricted .

ind:nc_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:QualityNonConformance ;
  rdfs:range xsd:string ;
  rdfs:label "Nc Id" ;
  :sensitivityTier :Confidential .

ind:nc_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:QualityNonConformance ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "OOS" "OOT" "Deviation" "Complaint" "AuditFinding" "CAPA" ) ] ;
  rdfs:label "Nc Type" ;
  :sensitivityTier :Confidential .

ind:severity
  a owl:DatatypeProperty ;
  rdfs:domain ind:QualityNonConformance ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Critical" "Major" "Minor" ) ] ;
  rdfs:label "Severity" ;
  :sensitivityTier :Confidential .

ind:detection_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:QualityNonConformance ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Detection Date" ;
  :sensitivityTier :Confidential .

ind:root_cause
  a owl:DatatypeProperty ;
  rdfs:domain ind:QualityNonConformance ;
  rdfs:range xsd:string ;
  rdfs:label "Root Cause" ;
  :sensitivityTier :Confidential .

ind:capa_due_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:QualityNonConformance ;
  rdfs:range xsd:date ;
  rdfs:label "Capa Due Date" ;
  :sensitivityTier :Confidential .

ind:capa_closed_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:QualityNonConformance ;
  rdfs:range xsd:date ;
  rdfs:label "Capa Closed Date" ;
  :sensitivityTier :Confidential .

ind:ActiveSubstance
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:substance_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ActiveSubstance
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:substance_name ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:AdverseEvent
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:ae_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:AdverseEvent
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:case_number ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:AdverseEvent
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:product_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:AdverseEvent
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:report_date ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Batch
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:batch_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Batch
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:batch_number ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Batch
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:expiry_date ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Batch
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:manufacture_date ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Batch
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:product_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:Batch
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:site_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ClinicalTrial
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:product_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ClinicalTrial
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:sponsor ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ClinicalTrial
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:trial_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ManufacturingSite
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:address ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ManufacturingSite
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:country_code ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ManufacturingSite
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:site_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:ManufacturingSite
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:site_name ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:MedicinalProduct
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:product_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:MedicinalProduct
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:product_name ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:QualityNonConformance
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:detection_date ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:QualityNonConformance
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:nc_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:QualityNonConformance
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:product_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:RegulatorySubmission
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:product_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:RegulatorySubmission
  rdfs:subClassOf [ a owl:Restriction ;
                    owl:onProperty ind:submission_id ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

ind:BatchRecallEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Batch Recall Event" ;
  rdfs:comment "A market recall initiated for a defective or unsafe batch." ;
  :sensitivityTier :Confidential .

ind:ClinicalTrialHoldEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Clinical Trial Hold" ;
  rdfs:comment "Regulatory hold placed on a clinical trial due to safety concerns." ;
  :sensitivityTier :Internal .

ind:PatentExpiryEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Patent Expiry Event" ;
  rdfs:comment "Patent protection expires, opening the product to generic competition." ;
  :sensitivityTier :Public .

<https://ontology.example.com/pharma/>
  rdfs:comment "Relationship (unformalised): A MedicinalProduct contains one or more ActiveSubstances." ;
  rdfs:comment "Relationship (unformalised): A ClinicalTrial investigates exactly one MedicinalProduct." ;
  rdfs:comment "Relationship (unformalised): A Batch is manufactured at exactly one ManufacturingSite." ;
  rdfs:comment "Relationship (unformalised): A Batch belongs to exactly one MedicinalProduct." ;
  rdfs:comment "Relationship (unformalised): An AdverseEvent is associated with exactly one MedicinalProduct." ;
  rdfs:comment "Relationship (unformalised): A RegulatorySubmission covers exactly one MedicinalProduct." ;
  rdfs:comment "Relationship (unformalised): A QualityNonConformance is linked to one Batch or one MedicinalProduct." ;
  rdfs:comment "Relationship (unformalised): A BatchRecallEvent invalidates one or more Batches."  .
