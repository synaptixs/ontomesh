@prefix :      <https://ontology.example.com/enterprise/> .
@prefix ind:   <https://ontology.example.com/government/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://ontology.example.com/government/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/government/1.0.0> ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Government & Public Sector Ontology Module" ;
  rdfs:comment "Domain template for government agencies, municipalities, and public sector organisations. Aligned with W3C DCAT v3, INSPIRE Directive (EU), and FOAF for agent descriptions. Suitable for open data portals, regulatory compliance, public service delivery, and e-government." ;
  dcterms:created "2026-07-26T15:22:11Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit Phase 3 — auto-generated from template" .


:Citizen
  a owl:Class ;
  rdfs:label "Citizen" ;
  rdfs:comment "A natural person interacting with government services." ;
  owl:equivalentClass <http://xmlns.com/foaf/0.1/Person> ;
  :sensitivityTier :Restricted .

:citizen_id
  a owl:DatatypeProperty ;
  rdfs:domain :Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Citizen Id" ;
  rdfs:comment "Anonymised/pseudonymised identifier" ;
  :sensitivityTier :Restricted .

:date_of_birth
  a owl:DatatypeProperty ;
  rdfs:domain :Citizen ;
  rdfs:range xsd:date ;
  rdfs:label "Date Of Birth" ;
  :sensitivityTier :Restricted .

:residency_status
  a owl:DatatypeProperty ;
  rdfs:domain :Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Residency Status" ;
  :sensitivityTier :Restricted .

:registration_date
  a owl:DatatypeProperty ;
  rdfs:domain :Citizen ;
  rdfs:range xsd:date ;
  rdfs:label "Registration Date" ;
  :sensitivityTier :Restricted .

:preferred_language
  a owl:DatatypeProperty ;
  rdfs:domain :Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Preferred Language" ;
  :sensitivityTier :Restricted .

:accessibility_needs
  a owl:DatatypeProperty ;
  rdfs:domain :Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Accessibility Needs" ;
  :sensitivityTier :Restricted .

:GovernmentAgency
  a owl:Class ;
  rdfs:label "Government Agency" ;
  rdfs:comment "A government body, ministry, department, or regulatory authority." ;
  owl:equivalentClass <http://www.w3.org/ns/org#Organization> ;
  :sensitivityTier :Public .

:agency_id
  a owl:DatatypeProperty ;
  rdfs:domain :GovernmentAgency ;
  rdfs:range xsd:string ;
  rdfs:label "Agency Id" ;
  :sensitivityTier :Public .

:agency_name
  a owl:DatatypeProperty ;
