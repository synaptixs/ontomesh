  rdfs:label "Is In Force" ;
  :sensitivityTier :Public .

ind:eli_uri
  a owl:DatatypeProperty ;
  rdfs:domain ind:Legislation ;
  rdfs:range xsd:string ;
  rdfs:label "Eli Uri" ;
  rdfs:comment "European Legislation Identifier URI" ;
  :sensitivityTier :Public .

ind:dataset_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Dataset ;
  rdfs:range xsd:string ;
  rdfs:label "Dataset Id" ;
  :sensitivityTier :Public .

ind:publisher
  a owl:DatatypeProperty ;
  rdfs:domain ind:Dataset ;
  rdfs:range xsd:string ;
  rdfs:label "Publisher" ;
  :sensitivityTier :Public .

ind:license
  a owl:DatatypeProperty ;
