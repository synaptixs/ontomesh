@prefix :      <https://ontology.example.com/enterprise/> .
@prefix ind:   <https://ontology.example.com/government/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://ontology.example.com/government/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/government/1.0.0> ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Government & Public Sector Ontology Module" ;
  rdfs:comment "Domain template for government agencies, municipalities, and public sector organisations. Aligned with W3C DCAT v3, INSPIRE Directive (EU), and FOAF for agent descriptions. Suitable for open data portals, regulatory compliance, public service delivery, and e-government." ;
  dcterms:created "2026-07-26T16:06:26Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit Phase 3 — auto-generated from template" .


ind:Citizen
  a owl:Class ;
  rdfs:label "Citizen" ;
  rdfs:comment "A natural person interacting with government services." ;
  owl:equivalentClass <http://xmlns.com/foaf/0.1/Person> ;
  :sensitivityTier :Restricted .

ind:GovernmentAgency
  a owl:Class ;
  rdfs:label "Government Agency" ;
  rdfs:comment "A government body, ministry, department, or regulatory authority." ;
  owl:equivalentClass <http://www.w3.org/ns/org#Organization> ;
  :sensitivityTier :Public .

ind:PublicService
  a owl:Class ;
  rdfs:label "Public Service" ;
  rdfs:comment "A service provided by a government agency to citizens or businesses." ;
  :sensitivityTier :Public .

ind:ServiceApplication
  a owl:Class ;
  rdfs:label "Service Application" ;
  rdfs:comment "A citizen or business application for a public service." ;
  :sensitivityTier :Restricted .

ind:Legislation
  a owl:Class ;
  rdfs:label "Legislation" ;
  rdfs:comment "A law, regulation, directive, or statutory instrument." ;
  :sensitivityTier :Public .

ind:Dataset
  a owl:Class ;
  rdfs:label "Open Data Dataset" ;
  rdfs:comment "A published government dataset available via an open data portal." ;
  owl:equivalentClass <http://www.w3.org/ns/dcat#Dataset> ;
  :sensitivityTier :Public .

ind:GeoFeature
  a owl:Class ;
  rdfs:label "Geographic Feature" ;
  rdfs:comment "A spatial entity in INSPIRE — administrative boundary, building, infrastructure." ;
  owl:equivalentClass <https://inspire.ec.europa.eu/vocab/SpatialObject> ;
  :sensitivityTier :Public .

ind:AuditRecord
  a owl:Class ;
  rdfs:label "Audit Record" ;
  rdfs:comment "An immutable log of government decision or data access for accountability." ;
  :sensitivityTier :Confidential .

ind:citizen_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Citizen Id" ;
  rdfs:comment "Anonymised/pseudonymised identifier" ;
  :sensitivityTier :Restricted .

ind:date_of_birth
  a owl:DatatypeProperty ;
  rdfs:domain ind:Citizen ;
  rdfs:range xsd:date ;
  rdfs:label "Date Of Birth" ;
  :sensitivityTier :Restricted .

ind:residency_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Residency Status" ;
  :sensitivityTier :Restricted .

ind:registration_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Citizen ;
  rdfs:range xsd:date ;
  rdfs:label "Registration Date" ;
  :sensitivityTier :Restricted .

ind:preferred_language
  a owl:DatatypeProperty ;
  rdfs:domain ind:Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Preferred Language" ;
  :sensitivityTier :Restricted .

ind:accessibility_needs
  a owl:DatatypeProperty ;
  rdfs:domain ind:Citizen ;
  rdfs:range xsd:string ;
  rdfs:label "Accessibility Needs" ;
  :sensitivityTier :Restricted .

ind:agency_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:GovernmentAgency ;
  rdfs:range xsd:string ;
  rdfs:label "Agency Id" ;
  :sensitivityTier :Public .

ind:agency_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:GovernmentAgency ;
  rdfs:range xsd:string ;
  rdfs:label "Agency Name" ;
  :sensitivityTier :Public .

ind:agency_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:GovernmentAgency ;
  rdfs:range xsd:string ;
  rdfs:label "Agency Type" ;
  :sensitivityTier :Public .

ind:jurisdiction
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:GovernmentAgency ind:Legislation ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Jurisdiction" ;
  :sensitivityTier :Public .

ind:parent_agency_id
  a owl:ObjectProperty ;
  rdfs:domain ind:GovernmentAgency ;
  rdfs:range ind:GovernmentAgency ;
  rdfs:label "Parent Agency Id" ;
  :sensitivityTier :Public .

ind:official_url
  a owl:DatatypeProperty ;
  rdfs:domain ind:GovernmentAgency ;
  rdfs:range xsd:string ;
  rdfs:label "Official Url" ;
  :sensitivityTier :Public .

ind:established_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:GovernmentAgency ;
  rdfs:range xsd:date ;
  rdfs:label "Established Date" ;
  :sensitivityTier :Public .

ind:service_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:PublicService ind:ServiceApplication ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Service Id" ;
  :sensitivityTier :Restricted .

ind:service_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:PublicService ;
  rdfs:range xsd:string ;
  rdfs:label "Service Name" ;
  :sensitivityTier :Public .

ind:owning_agency_id
  a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Dataset ind:PublicService ) ] ;
  rdfs:range ind:GovernmentAgency ;
  rdfs:label "Owning Agency Id" ;
  :sensitivityTier :Public .

ind:service_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:PublicService ;
  rdfs:range xsd:string ;
  rdfs:label "Service Type" ;
  :sensitivityTier :Public .

ind:delivery_channel
  a owl:DatatypeProperty ;
  rdfs:domain ind:PublicService ;
  rdfs:range xsd:string ;
  rdfs:label "Delivery Channel" ;
  :sensitivityTier :Public .

ind:average_processing_days
  a owl:DatatypeProperty ;
  rdfs:domain ind:PublicService ;
  rdfs:range xsd:integer ;
  rdfs:label "Average Processing Days" ;
  :sensitivityTier :Public .

ind:is_digital
  a owl:DatatypeProperty ;
  rdfs:domain ind:PublicService ;
  rdfs:range xsd:boolean ;
  rdfs:label "Is Digital" ;
  :sensitivityTier :Public .

ind:application_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:ServiceApplication ;
  rdfs:range xsd:string ;
  rdfs:label "Application Id" ;
  :sensitivityTier :Restricted .

ind:applicant_id
  a owl:ObjectProperty ;
  rdfs:domain ind:ServiceApplication ;
  rdfs:range ind:Citizen ;
  rdfs:label "Applicant Id" ;
  :sensitivityTier :Restricted .

ind:submission_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:ServiceApplication ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Submission Date" ;
  :sensitivityTier :Restricted .

ind:application_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:ServiceApplication ;
  rdfs:range xsd:string ;
  rdfs:label "Application Status" ;
  :sensitivityTier :Restricted .

ind:decision_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:ServiceApplication ;
  rdfs:range xsd:date ;
  rdfs:label "Decision Date" ;
  :sensitivityTier :Restricted .

ind:case_officer_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:ServiceApplication ;
  rdfs:range xsd:string ;
  rdfs:label "Case Officer Id" ;
  :sensitivityTier :Restricted .

ind:priority_flag
  a owl:DatatypeProperty ;
  rdfs:domain ind:ServiceApplication ;
  rdfs:range xsd:boolean ;
  rdfs:label "Priority Flag" ;
  :sensitivityTier :Restricted .

ind:legislation_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Legislation ;
  rdfs:range xsd:string ;
  rdfs:label "Legislation Id" ;
  :sensitivityTier :Public .

ind:title
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Dataset ind:Legislation ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Title" ;
  :sensitivityTier :Public .

ind:legislation_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Legislation ;
  rdfs:range xsd:string ;
  rdfs:label "Legislation Type" ;
  :sensitivityTier :Public .

ind:enactment_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Legislation ;
  rdfs:range xsd:date ;
  rdfs:label "Enactment Date" ;
  :sensitivityTier :Public .

ind:commencement_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Legislation ;
  rdfs:range xsd:date ;
  rdfs:label "Commencement Date" ;
  :sensitivityTier :Public .

ind:is_in_force
  a owl:DatatypeProperty ;
