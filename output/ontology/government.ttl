ind:audit_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:AuditRecord ;
  rdfs:range xsd:string ;
  rdfs:label "Audit Id" ;
  :sensitivityTier :Confidential .

ind:actor_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:AuditRecord ;
  rdfs:range xsd:string ;
  rdfs:label "Actor Id" ;
