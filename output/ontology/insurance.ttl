@prefix :      <https://ontology.example.com/enterprise/> .
@prefix ind:   <https://ontology.example.com/insurance/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://ontology.example.com/insurance/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/insurance/1.0.0> ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Insurance Ontology Module" ;
  rdfs:comment "Domain template for P&C, life, health, and specialty insurance carriers. Covers policy lifecycle, underwriting, claims management, reinsurance, and regulatory reporting. Aligned with ACORD (Association for Cooperative Operations Research and Development) standards." ;
  dcterms:created "2026-07-26T17:17:58Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit Phase 3 — auto-generated from template" .


ind:Policy
  a owl:Class ;
  rdfs:label "Insurance Policy" ;
  rdfs:comment "A contract between an insurer and a policyholder providing coverage for specified risks." ;
  owl:equivalentClass <https://www.acord.org/vocab/Policy> ;
  :sensitivityTier :Confidential .

ind:Policyholder
  a owl:Class ;
  rdfs:label "Policyholder" ;
  rdfs:comment "The individual or organisation that owns an insurance policy." ;
  :sensitivityTier :Restricted .

ind:Insurer
  a owl:Class ;
  rdfs:label "Insurer" ;
  rdfs:comment "An insurance company or underwriting syndicate providing coverage." ;
  :sensitivityTier :Public .

ind:Claim
  a owl:Class ;
  rdfs:label "Insurance Claim" ;
  rdfs:comment "A formal request by a policyholder for payment after a covered loss." ;
  owl:equivalentClass <https://www.acord.org/vocab/Claim> ;
  :sensitivityTier :Confidential .

ind:Underwriting
  a owl:Class ;
  rdfs:label "Underwriting Record" ;
  rdfs:comment "Risk assessment and pricing decision for a policy application." ;
  :sensitivityTier :Confidential .

ind:Reinsurance
  a owl:Class ;
  rdfs:label "Reinsurance Treaty" ;
  rdfs:comment "A contract between an insurer (cedant) and a reinsurer transferring risk." ;
  :sensitivityTier :Restricted .

ind:RegulatoryReturn
  a owl:Class ;
  rdfs:label "Regulatory Return" ;
  rdfs:comment "A statutory filing submitted to an insurance regulator (Solvency II, NAIC)." ;
  :sensitivityTier :Restricted .

ind:policy_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Claim ind:Policy ind:Underwriting ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Policy Id" ;
  :sensitivityTier :Confidential .

ind:policy_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:string ;
  rdfs:label "Policy Number" ;
  :sensitivityTier :Confidential .

ind:policy_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Auto" "Home" "Life" "Health" "Commercial" "Liability" "Marine" "Travel" "Cyber" "Specialty" ) ] ;
  rdfs:label "Policy Type" ;
  :sensitivityTier :Confidential .

ind:policyholder_id
  a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Policy ind:Policyholder ) ] ;
  rdfs:range ind:Policyholder ;
  rdfs:label "Policyholder Id" ;
  :sensitivityTier :Restricted .

ind:insurer_id
  a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Insurer ind:Policy ind:RegulatoryReturn ) ] ;
  rdfs:range ind:Insurer ;
  rdfs:label "Insurer Id" ;
  :sensitivityTier :Restricted .

ind:inception_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:date ;
  rdfs:label "Inception Date" ;
  :sensitivityTier :Confidential .

ind:expiry_date
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Policy ind:Reinsurance ) ] ;
  rdfs:range xsd:date ;
  rdfs:label "Expiry Date" ;
  :sensitivityTier :Restricted .

ind:premium_amount
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:decimal ;
  rdfs:label "Premium Amount" ;
  :sensitivityTier :Confidential .

ind:currency
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:string ;
  rdfs:label "Currency" ;
  :sensitivityTier :Confidential .

ind:coverage_limit
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:decimal ;
  rdfs:label "Coverage Limit" ;
  :sensitivityTier :Confidential .

ind:deductible_amount
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:decimal ;
  rdfs:label "Deductible Amount" ;
  :sensitivityTier :Confidential .

ind:policy_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Quote" "Bound" "Active" "Lapsed" "Cancelled" "Expired" "Renewed" ) ] ;
  rdfs:label "Policy Status" ;
  :sensitivityTier :Confidential .

ind:risk_score
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:decimal ;
  rdfs:label "Risk Score" ;
  :sensitivityTier :Confidential .

ind:entity_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policyholder ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Individual" "Business" "Trust" "GovernmentEntity" ) ] ;
  rdfs:label "Entity Type" ;
  :sensitivityTier :Restricted .

ind:date_of_birth
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policyholder ;
  rdfs:range xsd:date ;
  rdfs:label "Date Of Birth" ;
  rdfs:comment "For individuals only" ;
  :sensitivityTier :Restricted .

ind:industry_code
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policyholder ;
  rdfs:range xsd:string ;
  rdfs:label "Industry Code" ;
  rdfs:comment "SIC or NAICS for businesses" ;
  :sensitivityTier :Restricted .

ind:credit_score
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policyholder ;
  rdfs:range xsd:integer ;
  rdfs:label "Credit Score" ;
  :sensitivityTier :Restricted .

ind:years_as_customer
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policyholder ;
  rdfs:range xsd:integer ;
  rdfs:label "Years As Customer" ;
  :sensitivityTier :Restricted .

ind:kyc_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policyholder ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Pending" "Verified" "Rejected" "Review" ) ] ;
  rdfs:label "Kyc Status" ;
  :sensitivityTier :Restricted .

ind:insurer_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:Insurer ;
  rdfs:range xsd:string ;
  rdfs:label "Insurer Name" ;
  :sensitivityTier :Public .

ind:regulator_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Insurer ;
  rdfs:range xsd:string ;
  rdfs:label "Regulator Id" ;
  rdfs:comment "Regulatory reference FCA/NAIC" ;
  :sensitivityTier :Public .

ind:am_best_rating
  a owl:DatatypeProperty ;
  rdfs:domain ind:Insurer ;
  rdfs:range xsd:string ;
  rdfs:label "Am Best Rating" ;
  :sensitivityTier :Public .

ind:solvency_ratio_pct
  a owl:DatatypeProperty ;
  rdfs:domain ind:Insurer ;
  rdfs:range xsd:decimal ;
  rdfs:label "Solvency Ratio Pct" ;
  :sensitivityTier :Public .

ind:claim_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:string ;
  rdfs:label "Claim Id" ;
  :sensitivityTier :Confidential .

ind:claim_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:string ;
  rdfs:label "Claim Number" ;
  :sensitivityTier :Confidential .

ind:loss_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Loss Date" ;
  :sensitivityTier :Confidential .

ind:report_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Report Date" ;
  :sensitivityTier :Confidential .

ind:claim_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "MotorAccident" "TheftLoss" "PropertyDamage" "LiabilityBodily" "LifeDeath" "HealthMedical" "BusinessInterruption" "CyberIncident" ) ] ;
  rdfs:label "Claim Type" ;
  :sensitivityTier :Confidential .

ind:claim_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Fnol" "InvestigationOpen" "InvestigationClosed" "PartiallyPaid" "FullyPaid" "Denied" "Withdrawn" "Litigation" ) ] ;
  rdfs:label "Claim Status" ;
  :sensitivityTier :Confidential .

ind:reserve_amount
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:decimal ;
  rdfs:label "Reserve Amount" ;
  :sensitivityTier :Confidential .

ind:paid_amount
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:decimal ;
  rdfs:label "Paid Amount" ;
  :sensitivityTier :Confidential .

ind:adjuster_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:string ;
  rdfs:label "Adjuster Id" ;
  :sensitivityTier :Confidential .

ind:fraud_score
  a owl:DatatypeProperty ;
  rdfs:domain ind:Claim ;
  rdfs:range xsd:decimal ;
  rdfs:label "Fraud Score" ;
  :sensitivityTier :Confidential .

ind:underwriting_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Underwriting ;
  rdfs:range xsd:string ;
  rdfs:label "Underwriting Id" ;
  :sensitivityTier :Confidential .

ind:underwriter_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Underwriting ;
  rdfs:range xsd:string ;
  rdfs:label "Underwriter Id" ;
  :sensitivityTier :Confidential .

ind:risk_assessment_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Underwriting ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Risk Assessment Date" ;
  :sensitivityTier :Confidential .

ind:risk_class
  a owl:DatatypeProperty ;
  rdfs:domain ind:Underwriting ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Standard" "Preferred" "SubStandard" "Declined" ) ] ;
  rdfs:label "Risk Class" ;
  :sensitivityTier :Confidential .

ind:loading_factor
  a owl:DatatypeProperty ;
  rdfs:domain ind:Underwriting ;
  rdfs:range xsd:decimal ;
  rdfs:label "Loading Factor" ;
  rdfs:comment "Premium loading multiplier" ;
  :sensitivityTier :Confidential .

ind:referral_reason
  a owl:DatatypeProperty ;
  rdfs:domain ind:Underwriting ;
  rdfs:range xsd:string ;
  rdfs:label "Referral Reason" ;
  :sensitivityTier :Confidential .

ind:reinsurance_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:Reinsurance ;
  rdfs:range xsd:string ;
  rdfs:label "Reinsurance Id" ;
  :sensitivityTier :Restricted .

ind:treaty_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Reinsurance ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "QuotaShare" "SurplusShare" "ExcessOfLoss" "StopLoss" "Facultative" ) ] ;
  rdfs:label "Treaty Type" ;
  :sensitivityTier :Restricted .

ind:cedant_id
  a owl:ObjectProperty ;
  rdfs:domain ind:Reinsurance ;
  rdfs:range ind:Insurer ;
  rdfs:label "Cedant Id" ;
  :sensitivityTier :Restricted .

ind:reinsurer_name
  a owl:DatatypeProperty ;
  rdfs:domain ind:Reinsurance ;
  rdfs:range xsd:string ;
  rdfs:label "Reinsurer Name" ;
  :sensitivityTier :Restricted .

ind:retention_limit
  a owl:DatatypeProperty ;
  rdfs:domain ind:Reinsurance ;
  rdfs:range xsd:decimal ;
  rdfs:label "Retention Limit" ;
  :sensitivityTier :Restricted .

ind:cession_limit
  a owl:DatatypeProperty ;
  rdfs:domain ind:Reinsurance ;
  rdfs:range xsd:decimal ;
  rdfs:label "Cession Limit" ;
  :sensitivityTier :Restricted .

ind:effective_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Reinsurance ;
  rdfs:range xsd:date ;
  rdfs:label "Effective Date" ;
  :sensitivityTier :Restricted .

ind:return_id
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatoryReturn ;
  rdfs:range xsd:string ;
  rdfs:label "Return Id" ;
  :sensitivityTier :Restricted .

ind:return_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatoryReturn ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "SolvencyII_QRT" "SolvencyII_ORSA" "NAIC_Annual" "NAIC_Quarterly" "IFRS17" ) ] ;
  rdfs:label "Return Type" ;
  :sensitivityTier :Restricted .

ind:reporting_period
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatoryReturn ;
  rdfs:range xsd:string ;
  rdfs:label "Reporting Period" ;
  :sensitivityTier :Restricted .

ind:submission_deadline
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatoryReturn ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Submission Deadline" ;
  :sensitivityTier :Restricted .

ind:submission_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatoryReturn ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Submission Date" ;
  :sensitivityTier :Restricted .

ind:filing_status
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatoryReturn ;
  rdfs:range [ a rdfs:Datatype ;
               owl:oneOf ( "Pending" "Submitted" "Accepted" "Rejected" "Amended" ) ] ;
  rdfs:label "Filing Status" ;
  :sensitivityTier :Restricted .

ind:scr_ratio_pct
  a owl:DatatypeProperty ;
  rdfs:domain ind:RegulatoryReturn ;
  rdfs:range xsd:decimal ;
  rdfs:label "Scr Ratio Pct" ;
  rdfs:comment "Solvency Capital Requirement ratio" ;
  :sensitivityTier :Restricted .

