@prefix :      <https://ontology.example.com/enterprise/> .
@prefix ind:   <https://ontology.example.com/insurance/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://ontology.example.com/insurance/>
  a owl:Ontology ;
  owl:versionIRI <https://ontology.example.com/insurance/1.0.0> ;
  owl:imports <https://ontology.example.com/enterprise/> ;
  rdfs:label "Insurance Ontology Module" ;
  rdfs:comment "Domain template for P&C, life, health, and specialty insurance carriers. Covers policy lifecycle, underwriting, claims management, reinsurance, and regulatory reporting. Aligned with ACORD (Association for Cooperative Operations Research and Development) standards." ;
  dcterms:created "2026-07-26T16:06:26Z"^^xsd:dateTime ;
  dcterms:creator "Ontology Toolkit Phase 3 — auto-generated from template" .


ind:Policy
  a owl:Class ;
  rdfs:label "Insurance Policy" ;
  rdfs:comment "A contract between an insurer and a policyholder providing coverage for specified risks." ;
  owl:equivalentClass <https://www.acord.org/vocab/Policy> ;
  :sensitivityTier :Confidential .

ind:Policyholder
  a owl:Class ;
  rdfs:label "Policyholder" ;
  rdfs:comment "The individual or organisation that owns an insurance policy." ;
  :sensitivityTier :Restricted .

ind:Insurer
  a owl:Class ;
  rdfs:label "Insurer" ;
  rdfs:comment "An insurance company or underwriting syndicate providing coverage." ;
  :sensitivityTier :Public .

ind:Claim
  a owl:Class ;
  rdfs:label "Insurance Claim" ;
  rdfs:comment "A formal request by a policyholder for payment after a covered loss." ;
  owl:equivalentClass <https://www.acord.org/vocab/Claim> ;
  :sensitivityTier :Confidential .

ind:Underwriting
  a owl:Class ;
  rdfs:label "Underwriting Record" ;
  rdfs:comment "Risk assessment and pricing decision for a policy application." ;
  :sensitivityTier :Confidential .

ind:Reinsurance
  a owl:Class ;
  rdfs:label "Reinsurance Treaty" ;
  rdfs:comment "A contract between an insurer (cedant) and a reinsurer transferring risk." ;
  :sensitivityTier :Restricted .

ind:RegulatoryReturn
  a owl:Class ;
  rdfs:label "Regulatory Return" ;
  rdfs:comment "A statutory filing submitted to an insurance regulator (Solvency II, NAIC)." ;
  :sensitivityTier :Restricted .

ind:policy_id
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Claim ind:Policy ind:Underwriting ) ] ;
  rdfs:range xsd:string ;
  rdfs:label "Policy Id" ;
  :sensitivityTier :Confidential .

ind:policy_number
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:string ;
  rdfs:label "Policy Number" ;
  :sensitivityTier :Confidential .

ind:policy_type
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:string ;
  rdfs:label "Policy Type" ;
  :sensitivityTier :Confidential .

ind:policyholder_id
  a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Policy ind:Policyholder ) ] ;
  rdfs:range ind:Policyholder ;
  rdfs:label "Policyholder Id" ;
  :sensitivityTier :Restricted .

ind:insurer_id
  a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Insurer ind:Policy ind:RegulatoryReturn ) ] ;
  rdfs:range ind:Insurer ;
  rdfs:label "Insurer Id" ;
  :sensitivityTier :Restricted .

ind:inception_date
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:date ;
  rdfs:label "Inception Date" ;
  :sensitivityTier :Confidential .

ind:expiry_date
  a owl:DatatypeProperty ;
  rdfs:domain [ a owl:Class ;
                owl:unionOf ( ind:Policy ind:Reinsurance ) ] ;
  rdfs:range xsd:date ;
  rdfs:label "Expiry Date" ;
  :sensitivityTier :Restricted .

ind:premium_amount
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:decimal ;
  rdfs:label "Premium Amount" ;
  :sensitivityTier :Confidential .

ind:currency
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:string ;
  rdfs:label "Currency" ;
  :sensitivityTier :Confidential .

ind:coverage_limit
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
  rdfs:range xsd:decimal ;
  rdfs:label "Coverage Limit" ;
  :sensitivityTier :Confidential .

ind:deductible_amount
  a owl:DatatypeProperty ;
  rdfs:domain ind:Policy ;
