ind:FraudAlert
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Fraud Alert" ;
  rdfs:comment "A claim or application flagged for potential insurance fraud." ;
  :sensitivityTier :Restricted .

ind:PolicyLapseEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Policy Lapse Event" ;
  rdfs:comment "A policy became inactive due to non-payment of premium." ;
  :sensitivityTier :Confidential .

ind:LargeClaimEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Large Loss Event" ;
  rdfs:comment "A claim exceeding the large-loss threshold requiring senior adjuster." ;
  :sensitivityTier :Confidential .

ind:CatastropheEvent
  a owl:Class ;
  rdfs:subClassOf :DomainEvent ;
  rdfs:label "Catastrophe Event" ;
  rdfs:comment "A natural or man-made catastrophe triggering multiple claims." ;
  :sensitivityTier :Internal .

<https://ontology.example.com/insurance/>
  rdfs:comment "Relationship (unformalised): A Policy is held by exactly one Policyholder." ;
  rdfs:comment "Relationship (unformalised): A Policy is issued by exactly one Insurer." ;
  rdfs:comment "Relationship (unformalised): A Claim is lodged against exactly one Policy." ;
  rdfs:comment "Relationship (unformalised): An Underwriting record is created for exactly one Policy." ;
  rdfs:comment "Relationship (unformalised): A Reinsurance treaty is between exactly one cedant Insurer and a reinsurer." ;
  rdfs:comment "Relationship (unformalised): A RegulatoryReturn is filed by exactly one Insurer." ;
  rdfs:comment "Relationship (unformalised): A FraudAlert is associated with one or more Claims." ;
  rdfs:comment "Relationship (unformalised): A CatastropheEvent may trigger multiple Claims."  .
