  :hasDbTables "[\"tmf_customer_bill\",\"tmf_product\",\"tmf_agreement\"]" ;
  :hasSystemPromptHint "Focus on bill disputes, overdue payments, SLA-linked commercial agreements, and product subscription lifecycles." ;
